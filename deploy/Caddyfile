{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Pages, feeds and the search entry point change on every deploy.
	@fresh path / *.html */ *.xml /version.txt /pagefind/pagefind.js /pagefind/pagefind-entry.json
	header @fresh Cache-Control "no-cache"

	# Astro emits content-hashed file names under /assets/.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@static path /fonts/* /brand/* /og/* /film/* /js/* /favicon.svg /apple-touch-icon.png /site.webmanifest /robots.txt /pagefind/*
	header @static Cache-Control "public, max-age=86400"

	header {
		# 'wasm-unsafe-eval' is required by the Pagefind search index (WebAssembly).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
