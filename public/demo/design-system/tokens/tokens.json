  "typeScale": {
    "headline-1": {
      "value": "clamp(48px, calc(48px + 32 * ((100vw - 390px) / 1530)), 80px)",
      "min": "48px",
      "max": "80px",
      "minViewport": "390px",
      "maxViewport": "1920px"
    },
    "headline-2": {
