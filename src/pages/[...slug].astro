---
/* Single router for every localised page: home, section pages, news index, news posts, search.
   en lives at "/", uz at "/uz/", ru at "/ru/". */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Manifest from '../components/home/Manifest.astro';
import MediaHero from '../components/home/MediaHero.astro';
import LearnMore from '../components/home/LearnMore.astro';
import NewsCard from '../components/NewsCard.astro';
import SectionPage from '../components/SectionPage.astro';
import NewsArticle from '../components/NewsArticle.astro';
import Icon from '../components/Icon.astro';
import Numbers from '../components/home/Numbers.astro';
import ProductsIndex from '../components/products/ProductsIndex.astro';
import ProductPage from '../components/products/ProductPage.astro';
import AboutPage from '../components/company/AboutPage.astro';
import ChangelogPage from '../components/ChangelogPage.astro';
import NewsIndex from '../components/news/NewsIndex.astro';
import { categories } from '../i18n/home';
import FounderPage from '../components/company/FounderPage.astro';
import TimelinePage from '../components/company/TimelinePage.astro';
import ResearchIndex from '../components/research/ResearchIndex.astro';
import AreaPage from '../components/research/AreaPage.astro';
import ResearchArticle from '../components/research/ResearchArticle.astro';
import DocPage from '../components/docs/DocPage.astro';
import DocExtras from '../components/docs/DocExtras.astro';
import { readingMinutes, type Area } from '../data/research';
import { locales, defaultLocale, href, formatDate, type Locale } from '../i18n/config';
import { pages, groups, type PageDef } from '../i18n/pages';
import { home } from '../i18n/home';
import { ui } from '../i18n/ui';

export async function getStaticPaths() {
  const all = await getCollection('news');
  const rall = await getCollection('research');
  const out: { params: { slug: string | undefined }; props: Record<string, unknown> }[] = [];
  for (const locale of locales) {
    const pre = locale === defaultLocale ? '' : locale;
    const join = (p: string) => [pre, p.replace(/^\//, '')].filter(Boolean).join('/') || undefined;
    out.push({ params: { slug: join('') }, props: { kind: 'home', locale } });
    out.push({ params: { slug: join('news') }, props: { kind: 'news', locale } });
    out.push({ params: { slug: join('search') }, props: { kind: 'search', locale } });
    for (const page of pages) out.push({ params: { slug: join(page.path) }, props: { kind: 'page', locale, page } });
    for (const entry of all.filter((e) => e.id.endsWith(`/${locale}`))) {
      out.push({ params: { slug: join(`news/${entry.id.split('/')[0]}`) }, props: { kind: 'post', locale, id: entry.id } });
    }
    for (const entry of rall.filter((e) => e.id.endsWith(`/${locale}`))) {
      out.push({ params: { slug: join(`${entry.data.kind}/${entry.id.split('/')[0]}`) }, props: { kind: 'rpost', locale, id: entry.id } });
    }
  }
  return out;
}

const { kind, locale, page, id } = Astro.props as { kind: string; locale: Locale; page?: PageDef; id?: string };
const news = (await getCollection('news', (e) => e.id.endsWith(`/${locale}`)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || Number(b.data.featured) - Number(a.data.featured));
const card = (n: (typeof news)[number]) => ({ slug: n.id.split('/')[0], ...n.data });

let post: (typeof news)[number] | undefined, Content: any;
if (kind === 'post') { post = news.find((n) => n.id === id)!; ({ Content } = await render(post)); }

const rposts = (await getCollection('research', (e) => e.id.endsWith(`/${locale}`)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const lite = (e: (typeof rposts)[number]) => ({ slug: e.id.split('/')[0], title: e.data.title, description: e.data.description, date: e.data.date,
  kind: e.data.kind, area: e.data.area as Area, featured: e.data.featured, minutes: readingMinutes(e.body) });
let rpost: (typeof rposts)[number] | undefined, RContent: any, rheadings: { depth: number; slug: string; text: string }[] = [];
if (kind === 'rpost') { rpost = rposts.find((n) => n.id === id)!; ({ Content: RContent, headings: rheadings } = await render(rpost)); }
const areaOf = (k: string) => k.replace(/^research-/, '') as Area;
const areaCounts: Record<string, number> = { engineering: rposts.filter((r) => r.data.kind === 'engineering').length };
for (const r of rposts) areaCounts[r.data.area] = (areaCounts[r.data.area] ?? 0) + 1;

/* Policy / company documents: a page whose key has src/content/docs/<key>/<locale>.md renders as a document. */
const doc = kind === 'page' && page ? (await getCollection('docs')).find((d) => d.id === `${page.key}/${locale}`) : undefined;
let DContent: any, dheadings: { depth: number; slug: string; text: string }[] = [];
if (doc) ({ Content: DContent, headings: dheadings } = await render(doc));
const extras = page && ['rrp', 'brand', 'transparency'].includes(page.key) ? (page.key as 'rrp' | 'brand' | 'transparency') : undefined;

const meta = kind === 'home'
  ? { title: home.title[locale], description: home.description[locale] }
  : kind === 'news' ? { title: `${groups.news[locale]} · Wonmor`, description: ui.latestNews[locale] }
  : kind === 'search' ? { title: `${ui.search[locale]} · Wonmor`, description: ui.searchPlaceholder[locale] }
  : kind === 'post' ? { title: `${post!.data.title} · Wonmor`, description: post!.data.description }
  : kind === 'rpost' ? { title: `${rpost!.data.title} · Wonmor`, description: rpost!.data.description }
  : { title: `${page!.title[locale]} · Wonmor`, description: page!.lede[locale] };
---
<Base locale={locale} title={meta.title} description={meta.description} type={kind === 'post' || kind === 'rpost' ? 'article' : 'website'} published={post?.data.date ?? rpost?.data.date} noindex={kind === 'search'}>
  {kind === 'home' && (
    <>
      <Manifest lead={home.lead[locale]} statement={home.statement[locale]} />
      <MediaHero locale={locale} line1={home.heroLine1[locale]} line2={home.heroLine2[locale]} body={home.heroBody[locale]} label={home.filmLabel[locale]}
        cta1={{ text: home.heroCta1[locale], href: 'https://dtwin.uz', external: true }} cta2={{ text: home.heroCta2[locale], href: href(locale, '/products') }} />
      <section class="container section-lg" aria-labelledby="news-h">
        <div class="rule-row">
          <h2 class="t-caption-bold" id="news-h">{ui.latestNews[locale]}</h2>
          <a class="t-caption link-quiet fg-3" href={href(locale, '/news')}>{ui.allNews[locale]}</a>
        </div>
        <div class="home-cards">
          {news.slice(0, 3).map((n) => { const c = card(n); return <NewsCard locale={locale} {...c} />; })}
        </div>
      </section>
      <Numbers locale={locale} />
      <LearnMore locale={locale} />
    </>
  )}

  {kind === 'news' && (
    <NewsIndex locale={locale} news={news.map((n) => ({ slug: n.id.split('/')[0], title: n.data.title, description: n.data.description, date: n.data.date,
      category: n.data.category, product: n.data.product, featured: n.data.featured }))} />
  )}

  {kind === 'post' && post && (
    <NewsArticle locale={locale} title={post.data.title} description={post.data.description} date={post.data.date} category={post.data.category}
      links={post.data.links} related={news.filter((n) => n.id !== post!.id).slice(0, 2).map(card)}>
      <Content />
    </NewsArticle>
  )}

  {kind === 'page' && page && (
    page.key === 'research' ? <ResearchIndex locale={locale} page={page} posts={rposts.map(lite)} />
    : page.key.startsWith('research-') ? <AreaPage locale={locale} page={page} area={areaOf(page.key)} posts={rposts.filter((r) => r.data.area === areaOf(page.key)).map(lite)} counts={areaCounts} />
    : page.key === 'engineering' ? <AreaPage locale={locale} page={page} posts={rposts.filter((r) => r.data.kind === 'engineering').map(lite)} counts={areaCounts} />
    : page.key === 'products' ? <ProductsIndex locale={locale} page={page} />
    : page.key === 'changelog' ? <ChangelogPage locale={locale} page={page} />
    : page.group === 'products' && page.key.startsWith('p-') ? <ProductPage locale={locale} page={page} />
    : page.key === 'company' ? <AboutPage locale={locale} page={page} />
    : page.key === 'founder' ? <FounderPage locale={locale} page={page} />
    : page.key === 'timeline' ? <TimelinePage locale={locale} page={page} />
    : doc ? (
      <DocPage locale={locale} page={page} updated={doc.data.updated} summary={doc.data.summary} headings={dheadings}>
        {extras === 'transparency' && <DocExtras slot="above" locale={locale} kind="transparency" />}
        <DContent />
        {extras && extras !== 'transparency' && <DocExtras slot="below" locale={locale} kind={extras} />}
      </DocPage>
    )
    : <SectionPage locale={locale} page={page} />
  )}

  {kind === 'rpost' && rpost && (
    <ResearchArticle locale={locale} post={lite(rpost)} headings={rheadings} source={rpost.data.source} reproduce={rpost.data.reproduce}
      more={rposts.filter((r) => r.id !== rpost!.id && r.data.area === rpost!.data.area).slice(0, 3).map(lite)}>
      <RContent />
    </ResearchArticle>
  )}

  {kind === 'search' && (
    <section class="container page-top section-lg search-page" data-search-page>
      <h1 class="t-headline-2">{ui.search[locale]}</h1>
      <form class="search-page__form" role="search" data-search-form>
        <Icon name="search" size={20} />
        <label class="sr-only" for="sq">{ui.search[locale]}</label>
        <input id="sq" name="q" type="search" autocomplete="off" placeholder={ui.searchPlaceholder[locale]} />
      </form>
      <p class="t-body-4 fg-3" data-search-status aria-live="polite">{ui.searchEmpty[locale]}</p>
      <ol class="search-page__results dim-list" data-search-results role="list"></ol>
    </section>
  )}
</Base>

<script>
  import '../scripts/search';
</script>

<style>
  .home-cards { display: grid; gap: var(--grid-gutter); margin-top: 24px; grid-template-columns: 1fr; }
  @media (min-width: 768px) and (max-width: 1279px) { .home-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .home-cards { grid-template-columns: repeat(3, 1fr); } }
  .news-h { margin: 40px 0 8px; }
  .search-page { display: grid; gap: 24px; max-width: 980px; margin-inline: 0; }
  .search-page__form { display: flex; align-items: center; gap: 12px; height: 56px; padding: 0 16px; border: 1px solid var(--theme-border-primary); border-radius: 12px; background: var(--theme-popup-background); }
  .search-page__form input { flex: 1; border: 0; outline: 0; background: transparent; color: inherit; font: 400 var(--fs-body-2)/1 var(--sans); min-width: 0; }
  .search-page__form:focus-within { outline: 2px solid var(--theme-focus-ring); outline-offset: 2px; }
  .search-page__results { list-style: none; display: grid; }
  .search-page__results :global(li) { border-top: 1px solid var(--theme-border-secondary); }
  .search-page__results :global(a) { display: grid; gap: 6px; padding: 20px 0; text-decoration: none; transition: color .2s; }
  .search-page__results :global(mark) { background: var(--ill-oat); color: var(--gray-950); padding: 0 .1em; border-radius: 2px; }
</style>
