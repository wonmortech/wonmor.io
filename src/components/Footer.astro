---
/* Footer (DESIGN.md §5.10): slate theme, brand column, accordions, mission. */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { href, locales, localeNames, stripLocale, type Locale } from '../i18n/config';
import { footerGroups, socials } from '../i18n/pages';
import { resolve } from '../i18n/nav';
import { ui } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const here = stripLocale(Astro.url.pathname);
const year = 2026;
---
<footer class="site-footer theme-slate" data-footer>
  <div class="container ftr">
    <div class="ftr__brand">
      <Logo locale={locale} height={34} />
      <div class="ftr__legal">
        <ul class="ftr__social" role="list" aria-label={ui.social[locale]}>
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener me" aria-label={s.name}><Icon name={s.icon} size={20} /></a></li>)}
        </ul>
        <p class="t-caption fg-3">© {year} {ui.rights[locale]}</p>
      </div>
    </div>

    <div class="ftr__groups dim-list">
      {footerGroups.map((g) => (
        <details class="acc dim-item">
          <summary>{g.label[locale]}<Icon name="chevron-down" /></summary>
          <ul role="list">
            {g.items.map((it) => { const l = resolve(it, locale); return (
              <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}{l.external && <><Icon name="arrow-up-right" size={12} /><span class="sr-only">{ui.external[locale]}</span></>}</a></li>
            ); })}
          </ul>
        </details>
      ))}
    </div>

    <div class="ftr__mission">
      <h2 class="t-caption-bold">{ui.ourMission[locale]}</h2>
      <p class="t-body-4 fg-2">{ui.mission[locale]}</p>
      <div class="ftr__langs" role="group" aria-label={ui.language[locale]}>
        {locales.map((l) => <a href={href(l, here)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>{localeNames[l]}</a>)}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: 80px; margin-top: auto; }
  .ftr { display: grid; row-gap: 56px; grid-template-columns: 1fr; }
  .ftr__brand { display: flex; flex-direction: column; justify-content: space-between; gap: 40px; }
  .ftr__legal { display: grid; gap: 16px; }
  /* 20px icons with 44px touch targets; the negative margin keeps the visual layout */
  .ftr__social { list-style: none; display: flex; gap: 24px; }
  .ftr__social a { display: grid; place-items: center; width: 44px; height: 44px; margin: -12px; border-radius: 10px; color: var(--theme-foreground-secondary); transition: color .2s; }
  .ftr__social a:hover { color: var(--theme-foreground-primary); }
  .ftr__groups { display: block; }
  .ftr__mission { display: grid; gap: 12px; align-content: start; max-width: 40ch; }
  .ftr__langs { display: flex; flex-wrap: wrap; gap: 6px 2px; margin-inline: -8px; margin-top: 0; font: 400 var(--fs-caption-1)/1.5 var(--sans); }
  .ftr__langs a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 8px; color: var(--theme-foreground-tertiary); text-decoration: none; transition: color .2s; }
  .ftr__langs a:hover, .ftr__langs a[aria-current] { color: var(--theme-foreground-primary); }
  @media (min-width: 1024px) {
    .ftr { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gutter); }
    .ftr__brand { grid-column: 1 / span 3; }
    .ftr__groups { grid-column: 4 / span 6; }
    .ftr__mission { grid-column: 10 / span 3; }
  }
  @media (hover: hover) {
    .ftr__groups:has(.dim-item:hover) .dim-item:not(:hover) summary { color: var(--theme-foreground-quaternary); }
  }
</style>
