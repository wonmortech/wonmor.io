---
/* /research: lede, the seven areas as picture cards with counts, a dark featured strip, then every post. */
import Plate from '../Plate.astro';
import AreaIcon from '../ui/AreaIcon.astro';
import FeatureCarousel from '../ui/FeatureCarousel.astro';
import PostBrowser from './PostBrowser.astro';
import type { PostLite } from './PostRow.astro';
import { href, type Locale } from '../../i18n/config';
import { pageByKey, type PageDef } from '../../i18n/pages';
import { areaList, areaMotif, areaPageKey, postCount, researchUi as R } from '../../data/research';
interface Props { locale: Locale; page: PageDef; posts: PostLite[] }
const { locale, page, posts } = Astro.props;
const featured = [...posts.filter((p) => p.featured), ...posts.filter((p) => !p.featured)].slice(0, 5).map((p) => ({
  eyebrow: `${pageByKey[areaPageKey(p.area)].title[locale]} · ${R[p.kind][locale]}`, date: p.date, title: p.title, desc: p.description,
  href: href(locale, `/${p.kind}/${p.slug}`), motif: areaMotif[p.area], seed: p.slug,
}));
const count = (a: string) => posts.filter((p) => p.area === a).length;
---
<article class="ri">
  <header class="container page-top">
    <h1 class="t-headline-1 ri__title">{page.lede[locale]}</h1>
  </header>

  <section class="container section-lg" aria-labelledby="ri-a">
    <div class="rule-row"><h2 class="t-caption-bold" id="ri-a">{R.areas[locale]}</h2><a class="t-caption link-quiet fg-3" href={href(locale, '/engineering')}>{pageByKey['engineering'].title[locale]}</a></div>
    <ul class="ri__areas" role="list">
      {areaList.map((a, i) => {
        const pg = pageByKey[areaPageKey(a.key)];
        return (
          <li class="reveal-up" style={`transition-delay:${(i % 4) * 70}ms`}>
            <a class="acard has-icon-anim" href={href(locale, pg.path)}>
              <Plate motif={areaMotif[a.key]} ratio="16/9" />
              <span class="acard__top"><span class="acard__name"><AreaIcon name={a.key} size={22} /><span class="t-headline-5">{pg.title[locale]}</span></span>{pg.chip && <span class="chip">{pg.chip[locale]}</span>}</span>
              <span class="t-caption fg-3">{postCount(count(a.key), locale)}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {featured.length > 1 && (
    <section class="container section-lg" aria-labelledby="ri-f">
      <div class="rule-row"><h2 class="t-caption-bold" id="ri-f">{R.featured[locale]}</h2></div>
      <div class="ri__feat"><FeatureCarousel locale={locale} label={R.featured[locale]} items={featured} cta={R.readPost[locale]} prevLabel={R.prev[locale]} nextLabel={R.next[locale]} /></div>
    </section>
  )}

  <section class="container section-lg" aria-labelledby="ri-all">
    <h2 class="t-headline-3 ri__all-h" id="ri-all">{R.all[locale]}</h2>
    {posts.length ? <PostBrowser locale={locale} posts={posts} label={R.all[locale]} /> : <p class="t-body-4 fg-3">{R.noPosts[locale]}</p>}
  </section>
</article>

<style>
  .ri__title { max-width: 20ch; text-wrap: balance; }
  .ri__areas { list-style: none; display: grid; gap: 40px var(--grid-gutter); margin-top: 28px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .ri__areas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .ri__areas { grid-template-columns: repeat(4, 1fr); } }
  .acard { display: grid; gap: 10px; text-decoration: none; color: inherit; }
  .acard :global(.plate) { margin-bottom: 6px; }
  .acard__top { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }

  .ri__feat { margin-top: 28px; }
  .ri__all-h { margin-bottom: 28px; }
  .acard__name { display: inline-flex; align-items: center; gap: 10px; }
</style>
