---
/* /research hub (anthropic.com research hub pattern): the statement H1; directly under it the areas strip (the same
   component as "Explore": mark, name, post count, lede, 01 / 08 pager), so the hub's navigation is its content;
   the featured carousel on a full-bleed slate band; then every post, gallery view by default. */
import FeatureCarousel from '../ui/FeatureCarousel.astro';
import ExploreAreas from './ExploreAreas.astro';
import PostBrowser from './PostBrowser.astro';
import type { PostLite } from './PostRow.astro';
import { href, type Locale } from '../../i18n/config';
import { pageByKey, type PageDef } from '../../i18n/pages';
import { areaMotif, areaPageKey, researchUi as R } from '../../data/research';
interface Props { locale: Locale; page: PageDef; posts: PostLite[] }
const { locale, page, posts } = Astro.props;
const featured = [...posts.filter((p) => p.featured), ...posts.filter((p) => !p.featured)].slice(0, 5).map((p) => ({
  eyebrow: `${pageByKey[areaPageKey(p.area)].title[locale]} · ${R[p.kind][locale]}`, date: p.date, title: p.title, desc: p.description,
  href: href(locale, `/${p.kind}/${p.slug}`), motif: areaMotif[p.area], seed: p.slug,
}));
const counts: Record<string, number> = { engineering: posts.filter((p) => p.kind === 'engineering').length };
for (const p of posts) counts[p.area] = (counts[p.area] ?? 0) + 1;
---
<article class="ri">
  <header class="container page-top">
    <h1 class="t-headline-1 ri__title">{page.lede[locale]}</h1>
  </header>

  <section class="ri__strip" aria-labelledby="ri-a">
    <div class="container"><div class="rule-row"><h2 class="t-caption-bold" id="ri-a">{R.areas[locale]}</h2><a class="t-caption link-quiet fg-3" href={href(locale, '/engineering')}>{pageByKey['engineering'].title[locale]}</a></div></div>
    <ExploreAreas locale={locale} counts={counts} />
  </section>

  {featured.length > 1 && (
    <section class="ri__band theme-slate" aria-labelledby="ri-f">
      <div class="container">
        <div class="rule-row"><h2 class="t-caption-bold" id="ri-f">{R.featured[locale]}</h2></div>
        <div class="ri__feat"><FeatureCarousel locale={locale} label={R.featured[locale]} items={featured} cta={R.readPost[locale]} prevLabel={R.prev[locale]} nextLabel={R.next[locale]} /></div>
      </div>
    </section>
  )}

  <section class="container section-lg" aria-labelledby="ri-all">
    <h2 class="t-headline-3 ri__all-h" id="ri-all">{R.all[locale]}</h2>
    {posts.length ? <PostBrowser locale={locale} posts={posts} label={R.all[locale]} view="gallery" /> : <p class="t-body-4 fg-3">{R.noPosts[locale]}</p>}
  </section>
</article>

<style>
  .ri__title { max-width: 20ch; text-wrap: balance; }
  /* the strip reuses ExploreAreas; on the hub its own centred "other areas" heading gives way to the rule-row above */
  .ri__strip { margin-top: 48px; }
  @media (min-width: 1024px) { .ri__strip { margin-top: 72px; } }
  .ri__strip :global(.ex) { padding-top: 0; }
  .ri__strip :global(.ex__h) { display: none; }
  .ri__strip :global(.ex__track) { margin-top: 24px; }

  .ri__band { background: var(--theme-background-primary); color: var(--theme-foreground-primary); padding-block: 64px 72px; }
  @media (min-width: 1024px) { .ri__band { padding-block: 88px 96px; } }
  .ri__feat { margin-top: 28px; }
  .ri__all-h { margin-bottom: 28px; }
</style>
