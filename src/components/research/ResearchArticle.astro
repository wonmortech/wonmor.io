---
/* Long-form research/engineering post: serif column, sticky contents on the left, meta on the right,
   then "Reproduce this", sources and related posts.
   3+ sections: a sticky section bar replaces the left contents; wide screens get a sticky related rail under the meta. */
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import SectionBar from '../article/SectionBar.astro';
import Related from '../article/Related.astro';
import '../article/figures.css';
import type { PostLite } from './PostRow.astro';
import { formatDate, href, type Locale } from '../../i18n/config';
import { pageByKey } from '../../i18n/pages';
import { areaPageKey, readingMinutes, researchUi as R, type Area } from '../../data/research';
import { founder } from '../../data/company';
interface Props { locale: Locale; post: PostLite; headings: { depth: number; slug: string; text: string }[]; source: string[];
  reproduce?: { repo?: string; commit?: string; note?: string; commands: string[] }; more: PostLite[] }
const { locale, post, headings, source, reproduce } = Astro.props; // `more` is superseded by the related posts below
const areaPg = pageByKey[areaPageKey(post.area as Area)];
const kindPg = post.kind === 'engineering' ? pageByKey['engineering'] : pageByKey['research'];
const toc = headings.filter((h) => h.depth === 2);
const isUrl = (s: string) => /^https?:\/\//.test(s);
const hasBar = toc.length >= 3;

/* Related: same area and kind first, then same area, then same kind; newest first; never this post. */
const pool = (await getCollection('research', (e) => e.id.endsWith(`/${locale}`) && e.id.split('/')[0] !== post.slug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const rank = (e: (typeof pool)[number]) => (e.data.area === post.area ? 2 : 0) + (e.data.kind === post.kind ? 1 : 0);
const related: PostLite[] = pool.filter((e) => rank(e) > 0).sort((a, b) => rank(b) - rank(a)).slice(0, 2)
  .map((e) => ({ slug: e.id.split('/')[0], title: e.data.title, description: e.data.description, date: e.data.date, kind: e.data.kind,
    area: e.data.area as Area, featured: e.data.featured, minutes: readingMinutes(e.body) }));
const moreHref = href(locale, post.kind === 'engineering' ? kindPg.path : areaPg.path);
---
<article class="ra">
  <header class="container page-top ra__head">
    <p class="t-caption fg-3"><a class="link-quiet" href={href(locale, kindPg.path)}>{kindPg.title[locale]}</a> · <a class="link-quiet" href={href(locale, areaPg.path)}>{areaPg.title[locale]}</a></p>
    <h1 class="ra__title">{post.title}</h1>
    <p class="ra__dek">{post.description}</p>
    <p class="t-caption fg-3"><time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date, locale)}</time> · {post.minutes} {R.read[locale]}</p>
  </header>

  <div class:list={['ra__main', { 'has-secbar': hasBar }]}>
  {hasBar && <SectionBar locale={locale} headings={toc} />}
  <div class="container ra__grid">
    {toc.length > 1 && !hasBar && (
      <nav class="ra__toc t-caption" aria-labelledby="ra-toc">
        <p class="t-caption-bold" id="ra-toc">{R.contents[locale]}</p>
        <ol role="list">{toc.map((h) => <li><a class="link-quiet" href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="ra__body prose"><slot /></div>
    <div class="ra__side">
    <aside class="ra__meta t-caption" aria-label={R.published[locale]}>
      <dl>
        <div><dt>{R.published[locale]}</dt><dd>{formatDate(post.date, locale)}</dd></div>
        <div><dt>{R.author[locale]}</dt><dd><a class="link-underline" href={href(locale, '/company/founder')}>{founder.name}</a></dd></div>
        <div><dt>{R.area[locale]}</dt><dd><a class="link-underline" href={href(locale, areaPg.path)}>{areaPg.title[locale]}</a></dd></div>
        <div><dt>{R.type[locale]}</dt><dd>{R[post.kind][locale]}</dd></div>
      </dl>
    </aside>
    <Related locale={locale} variant="rail" kind="research" posts={related} moreHref={moreHref} />
    </div>
  </div>
  </div>

  {reproduce && reproduce.commands.length > 0 && (
    <section class="container ra__wide" aria-labelledby="ra-rep">
      <div class="ra__rep">
        <h2 class="t-headline-5" id="ra-rep"><Icon name="arrow-right" size={16} />{R.reproduce[locale]}</h2>
        {reproduce.note && <p class="t-body-4 ra__rep-note">{reproduce.note}</p>}
        <pre class="ra__cmd" tabindex="0"><code>{reproduce.commands.map((c) => `$ ${c}`).join('\n')}</code></pre>
        <dl class="t-caption ra__rep-meta">
          {reproduce.repo
            ? <div><dt>{R.repo[locale]}</dt><dd><a class="link-underline" href={reproduce.repo} target="_blank" rel="noopener">{reproduce.repo.replace('https://github.com/', '')}</a></dd></div>
            : <div><dt>{R.repo[locale]}</dt><dd>{R.private[locale]}</dd></div>}
          {reproduce.repo && reproduce.commit && <div><dt>{R.commit[locale]}</dt><dd><a class="link-underline" href={`${reproduce.repo}/commit/${reproduce.commit}`} target="_blank" rel="noopener"><code>{reproduce.commit.slice(0, 7)}</code></a></dd></div>}
          <div><dt>{R.material[locale]}</dt><dd><a class="link-underline" href={`https://github.com/wonmortech/research/tree/main/posts/${post.slug}`} target="_blank" rel="noopener">wonmortech/research</a></dd></div>
        </dl>
      </div>
    </section>
  )}

  <section class="container ra__wide" aria-labelledby="ra-src">
    <h2 class="t-caption-bold ra__src-h" id="ra-src">{R.sources[locale]}</h2>
    <ol class="t-caption ra__src" role="list">
      {source.map((s) => <li>{isUrl(s) ? <a class="link-underline" href={s} target="_blank" rel="noopener">{s.replace(/^https?:\/\//, '')}</a> : s}</li>)}
    </ol>
  </section>

  <Related locale={locale} variant="section" kind="research" posts={related} moreHref={moreHref} />
</article>

<style>
  .ra__head { display: grid; justify-items: center; text-align: center; gap: 20px; padding-bottom: 56px; }
  .ra__title { font: 500 clamp(32px, calc(32px + 24 * ((100vw - 390px) / 1530)), 56px)/1.08 var(--serif); font-variation-settings: 'opsz' 48; letter-spacing: -.015em; max-width: 20ch; text-wrap: balance; }
  .ra__dek { font: 400 clamp(18px, calc(18px + 4 * ((100vw - 390px) / 1530)), 22px)/1.45 var(--sans); color: var(--theme-foreground-secondary); max-width: 36em; text-wrap: pretty; }
  .ra__grid { display: grid; gap: 40px; }
  .ra__grid > *, .ra__wide > * { min-width: 0; }
  @media (min-width: 1024px) {
    .ra__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gutter); align-items: start; }
    .ra__toc { grid-column: 1 / span 2; position: sticky; top: 96px; }
    .ra__body { grid-column: 4 / span 6; grid-row: 1; }
    .ra__side { grid-column: 11 / span 2; grid-row: 1; align-self: stretch; }
  }
  .ra__toc ol { list-style: none; display: grid; gap: 10px; margin-top: 14px; padding-left: 12px; border-left: 1px solid var(--theme-border-secondary); }
  .ra__toc a { color: var(--theme-foreground-secondary); }
  @media (max-width: 1023px) { .ra__toc { padding: 20px; border-radius: 12px; background: var(--theme-background-secondary); } }
  .ra__body { max-width: var(--reading-width); width: 100%; margin-inline: auto; }
  .ra__meta dl > div { display: grid; gap: 2px; padding: 12px 0; border-top: 1px solid var(--theme-border-secondary); }
  .ra__meta dt { color: var(--theme-foreground-primary); }
  .ra__meta dd { color: var(--theme-foreground-tertiary); }
  .ra__wide { margin-top: 64px; }
  @media (min-width: 1024px) { .ra__wide > * { margin-left: calc((100% - 11 * var(--grid-gutter)) / 12 * 3 + 3 * var(--grid-gutter)); max-width: calc((100% - 11 * var(--grid-gutter)) / 12 * 6 + 5 * var(--grid-gutter)); } }
  .ra__rep { padding: 32px; border-radius: var(--radius-card); background: #141413; color: #faf9f5; display: grid; gap: 16px; }
  .ra__rep h2 { display: flex; align-items: center; gap: 10px; }
  .ra__rep-note { color: rgba(250, 249, 245, .75); }
  .ra__cmd { font: 400 14px/1.7 var(--mono); background: rgba(250, 249, 245, .06); border: 1px solid rgba(250, 249, 245, .12); border-radius: 10px; padding: 16px 18px; overflow-x: auto; white-space: pre; }
  .ra__rep-meta { display: grid; gap: 8px; color: rgba(250, 249, 245, .6); }
  .ra__rep-meta > div { display: flex; gap: 12px; flex-wrap: wrap; } .ra__rep-meta dt { color: #faf9f5; min-width: 7em; }
  .ra__rep-meta a { color: inherit; }
  .ra__src-h { padding-top: 16px; border-top: 1px solid var(--theme-border-secondary); }
  .ra__src { list-style: decimal; padding-left: 1.4em; margin-top: 14px; display: grid; gap: 6px; color: var(--theme-foreground-tertiary); word-break: break-word; }

</style>
