---
/* "Explore work from other areas" (anthropic.com engineering pattern): centred heading, a row of areas, each with an
   animated line icon, a rolling title, its post count and lede; arrows and a 01 / 07 counter scroll the row. */
import Icon from '../Icon.astro';
import AreaIcon from '../ui/AreaIcon.astro';
import SwapText from '../ui/SwapText.astro';
import { href, type Locale } from '../../i18n/config';
import { pageByKey } from '../../i18n/pages';
import { areaList, areaPageKey, postCount, researchUi as R, type Area } from '../../data/research';
interface Props { locale: Locale; counts: Record<string, number>; exclude?: Area | 'engineering' }
const { locale, counts, exclude } = Astro.props;
const items = [
  ...areaList.map((a) => ({ key: a.key as Area | 'engineering', page: pageByKey[areaPageKey(a.key)] })),
  { key: 'engineering' as const, page: pageByKey['engineering'] },
].filter((x) => x.key !== exclude);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="ex container section-lg" data-carousel aria-labelledby="ex-h">
  <h2 class="t-headline-3 ex__h" id="ex-h">{R.explore[locale]}</h2>
  <ul class="ex__track" role="list" data-track>
    {items.map((x) => (
      <li class="ex__item" data-slide>
        <a class="ex__link has-icon-anim has-swap" href={href(locale, x.page.path)}>
          <span class="ex__top"><AreaIcon name={x.key === 'engineering' ? 'engineering' : x.key} /><span class="t-headline-5"><SwapText text={x.page.title[locale]} /></span></span>
          <span class="ex__count t-caption">{postCount(counts[x.key] ?? 0, locale)}</span>
          <span class="ex__lede t-body-4">{x.page.lede[locale]}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="ex__pager">
    <button type="button" class="ex__btn" data-prev aria-label={R.prev[locale]}><Icon name="arrow-left" size={16} /></button>
    <span class="ex__num t-caption"><span data-index>01</span> / {pad(items.length)}</span>
    <button type="button" class="ex__btn" data-next aria-label={R.next[locale]}><Icon name="arrow-right" size={16} /></button>
  </div>
</section>

<script>
  import { initCarousels } from '../../scripts/carousel';
  initCarousels();
</script>

<style>
  .ex__h { text-align: center; }
  .ex__track { list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: var(--grid-gutter);
    margin: 40px calc(var(--grid-margin) * -1) 0; padding: 0 var(--grid-margin) 4px; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--grid-margin); scrollbar-width: none; overscroll-behavior-x: contain; }
  .ex__track::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) { .ex__track { grid-auto-columns: calc((100% - var(--grid-margin) * 2 - var(--grid-gutter) * 2) / 3); } }
  @media (min-width: 1280px) { .ex__track { grid-auto-columns: calc((100% - var(--grid-margin) * 2 - var(--grid-gutter) * 3.5) / 4.5); } }
  .ex__item { scroll-snap-align: start; border-top: 1px solid var(--theme-border-secondary); }
  .ex__link { display: grid; gap: 8px; padding: 20px 0 8px; text-decoration: none; color: var(--theme-foreground-primary); }
  .ex__top { display: flex; align-items: flex-start; gap: 12px; }
  .ex__top :global(.aicon) { margin-top: .1em; }
  .ex__count { color: var(--theme-foreground-tertiary); font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .ex__lede { color: var(--theme-foreground-secondary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  /* a line draws across the top of the hovered area */
  .ex__item { position: relative; }
  .ex__item::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--theme-foreground-primary); transform: scaleX(0); transform-origin: left; }
  .ex__item:has(.ex__link:is(:hover, :focus-visible))::before { transform: scaleX(1); }
  @media (prefers-reduced-motion: no-preference) { .ex__item::before { transition: transform .7s var(--ease-out-quart); } }
  .ex__pager { display: flex; justify-content: center; align-items: center; gap: 12px; margin-top: 28px; }
  .ex__num { font-family: var(--mono); color: var(--theme-foreground-tertiary); min-width: 5.5em; text-align: center; }
  .ex__num [data-index] { color: var(--theme-foreground-primary); }
  .ex__btn { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; border: 1px solid var(--theme-border-secondary);
    background: transparent; color: var(--theme-foreground-primary); transition: background-color .2s; }
  .ex__btn:hover { background: var(--theme-background-secondary); }
  @media (pointer: coarse) { .ex__btn { width: 44px; height: 44px; } }
</style>
