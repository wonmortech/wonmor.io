---
/* /company/timeline: one vertical line drawn as you scroll; events grouped by year, newest first. */
import Icon from '../Icon.astro';
import { formatDate, href, type Locale } from '../../i18n/config';
import { pageByKey, type PageDef } from '../../i18n/pages';
import { timeline, timelineKinds } from '../../data/company';
interface Props { locale: Locale; page: PageDef }
const { locale, page } = Astro.props;
const years = [...new Set(timeline.map((e) => e.date.slice(0, 4)))];
const company = pageByKey['company'];
const exactDay = (d: string) => !d.endsWith('-01') || d.startsWith('2026-1');
const monthYear = (d: string) => new Intl.DateTimeFormat(locale === 'uz' ? 'uz-Latn' : locale, { month: 'long', year: 'numeric' }).format(new Date(d));
---
<article class="tl">
  <header class="container page-top">
    <p class="t-caption fg-3"><a class="link-quiet" href={href(locale, company.path)}>{company.title[locale]}</a></p>
    <h1 class="t-headline-2 tl__title">{page.title[locale]}</h1>
    <p class="t-sub-3 fg-2 tl__lede">{page.lede[locale]}</p>
  </header>

  <div class="container tl__body" data-tl>
    <span class="tl__rail" aria-hidden="true"><span data-tl-fill></span></span>
    {years.map((y) => (
      <section class="tl__year" aria-labelledby={`y${y}`}>
        <h2 class="tl__y" id={`y${y}`}>{y}</h2>
        <ol class="tl__list" role="list">
          {timeline.filter((e) => e.date.startsWith(y)).map((e) => (
            <li class={`tl__ev tl__ev--${e.kind} reveal-up`}>
              <span class="tl__dot" aria-hidden="true"></span>
              <p class="t-caption fg-3"><time datetime={e.date}>{exactDay(e.date) ? formatDate(new Date(e.date), locale) : monthYear(e.date)}</time> · {timelineKinds[e.kind][locale]}</p>
              {e.href
                ? <a class="tl__ev-title tl__ev-link" href={href(locale, e.href)}>{e.title[locale]}<Icon name="arrow-right" size={14} /></a>
                : <p class="tl__ev-title">{e.title[locale]}</p>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</article>

<script>
  const root = document.querySelector<HTMLElement>('[data-tl]');
  const fill = root?.querySelector<HTMLElement>('[data-tl-fill]');
  if (root && fill && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = root.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
      fill.style.transform = `scaleY(${p.toFixed(4)})`;
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  } else if (fill) fill.style.transform = 'none';
</script>

<style>
  .tl__title { margin-top: 12px; }
  .tl__lede { max-width: 36em; margin-top: 24px; }
  .tl__body { position: relative; margin-top: 72px; padding-bottom: var(--section-spacer-lg); --rail: 7px; }
  @media (min-width: 1024px) { .tl__body { --rail: calc((100% - 2 * var(--grid-margin) - 11 * var(--grid-gutter)) / 12 * 3 + 3 * var(--grid-gutter) + 7px); } }
  /* --rail is measured from the content edge, so the line runs through the centre of each dot */
  .tl__rail { position: absolute; top: 0; bottom: var(--section-spacer-lg); left: calc(var(--grid-margin) + var(--rail)); width: 2px; background: var(--theme-border-secondary); }
  .tl__rail span { position: absolute; inset: 0; background: var(--theme-foreground-primary); transform: scaleY(0); transform-origin: top; }
  .tl__year { display: grid; gap: 8px; margin-bottom: 56px; }
  @media (min-width: 1024px) { .tl__year { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gutter); } .tl__y { grid-column: 1 / span 2; } .tl__list { grid-column: 4 / span 8; } }
  .tl__y { font: 500 clamp(40px, 5vw, 64px)/1 var(--serif); letter-spacing: -.02em; padding-left: 32px; position: sticky; top: 96px; align-self: start; }
  @media (min-width: 1024px) { .tl__y { padding-left: 0; } }
  .tl__list { list-style: none; display: grid; }
  .tl__ev { position: relative; display: grid; gap: 4px; padding: 16px 0 16px 32px; }
  .tl__dot { position: absolute; left: 2px; top: 20px; width: 12px; height: 12px; border-radius: 50%; background: var(--theme-background-primary); border: 2px solid var(--theme-foreground-quaternary); }
  .tl__ev--release .tl__dot { background: var(--ill-gold); border-color: var(--ill-gold); }
  .tl__ev--org .tl__dot { background: var(--theme-foreground-primary); border-color: var(--theme-foreground-primary); }
  .tl__ev--product .tl__dot { border-color: var(--ill-lapis); }
  .tl__ev-title { font: 500 clamp(18px, calc(18px + 4 * ((100vw - 390px) / 1530)), 22px)/1.3 var(--sans); letter-spacing: -.01em; }
  .tl__ev-link { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; padding-block: 10px; margin-block: -10px; }
  .tl__ev-link :global(svg) { transition: transform .3s var(--ease-out-quart); }
  @media (hover: hover) { .tl__ev-link:hover { text-decoration: underline; text-underline-offset: .2em; } .tl__ev-link:hover :global(svg) { transform: translateX(3px); } }
</style>
