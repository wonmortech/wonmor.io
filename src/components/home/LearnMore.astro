---
/* "Learn more" carousel (DESIGN.md §5.8): rule eyebrow + 4:5 cards; scroll-snap instead of a JS carousel. */
import Plate from '../Plate.astro';
import { href, type Locale } from '../../i18n/config';
import { pageByKey } from '../../i18n/pages';
import { ui } from '../../i18n/ui';
import { home } from '../../i18n/home';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="container section-lg lm reveal-up" aria-labelledby="lm-h">
  <div class="rule-row"><h2 class="t-caption-bold" id="lm-h">{ui.learnMore[locale]}</h2></div>
  <ul class="lm__track" role="list">
    {home.learnMore.map((c) => { const p = pageByKey[c.key]; return (
      <li class="lm__slide">
        <a class="lm__card" href={href(locale, p.path)}>
          <Plate motif={c.art} />
          <h3 class="lm__title t-headline-5">{p.title[locale]}</h3>
          <p class="lm__sub t-caption">{c.sub[locale]}</p>
        </a>
      </li>
    ); })}
  </ul>
</section>

<style>
  .lm__track { list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: 75%; gap: var(--grid-gutter);
    margin: 24px calc(var(--grid-margin) * -1) 0; padding: 0 var(--grid-margin) 8px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--grid-margin); scrollbar-width: none; overscroll-behavior-x: contain; }
  .lm__track::-webkit-scrollbar { display: none; }
  .lm__slide { scroll-snap-align: start; }
  @media (min-width: 768px) { .lm__track { grid-auto-columns: calc((100% - var(--grid-margin) * 2 - var(--grid-gutter) * 1.4) / 2.4); } }
  @media (min-width: 1280px) { .lm__track { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); grid-auto-columns: auto; overflow: visible; margin-inline: 0; padding-inline: 0; } }
  .lm__card { display: grid; gap: 0; text-decoration: none; color: inherit; }
  .lm__title { margin-top: 16px; transition: color .2s; }
  .lm__sub { margin-top: 6px; color: var(--theme-foreground-tertiary); transition: color .2s; max-width: 40ch; }
  @media (hover: hover) { .lm__card:hover :is(.lm__title, .lm__sub) { color: var(--theme-foreground-quaternary); } }
  .lm__card:focus-visible :is(.lm__title, .lm__sub) { color: var(--theme-foreground-quaternary); }
</style>
