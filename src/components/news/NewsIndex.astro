---
/* /news (anthropic.com newsroom pattern, Wonmor content and art):
   1. "Latest" mosaic: a picture story and a text story left, the lead story with a large picture in the middle, three
      text stories right; phones stack it.
   2. "Highlights": featured posts in a carousel.
   3. Every post as a table (title, summary, topic, date, expander) with a segmented All / Product / Company control
      (?group=), a multi-select Filter for the other topics (?category=a,b), sort (?sort=), search and "See more".
   4. A dark band to the press kit, contact and security pages.
   Pictures are real product screenshots when the post is about a product with one, otherwise a Wonmor plate. */
import Icon from '../Icon.astro';
import Plate, { type Motif } from '../Plate.astro';
import FeatureCarousel from '../ui/FeatureCarousel.astro';
import Select from '../ui/Select.astro';
import { formatDate, href, type Locale } from '../../i18n/config';
import { categories } from '../../i18n/home';
import { groups, pageByKey } from '../../i18n/pages';
import { ui } from '../../i18n/ui';
import { productMedia } from '../../data/media';

export interface NewsLite { slug: string; title: string; description: string; date: Date; category: string; product?: string; featured: boolean }
interface Props { locale: Locale; news: NewsLite[] }
const { locale, news } = Astro.props;

const motifByProduct: Record<string, Motif> = {
  dtwin: 'faith', bitg: 'language', teletwin: 'interfaces', gateway: 'agents', tunnel: 'infrastructure', fam: 'agents', operobot: 'agents',
  shop: 'products', gym: 'useful', med: 'useful', 'faktura-twin': 'interfaces', attendo: 'events', oilaviy: 'contact', 'primus-library': 'legal',
  halvet: 'brand', xnosir: 'founder',
};
const motifByCategory: Record<string, Motif> = { announcements: 'company', company: 'company', engineering: 'engineering', research: 'research', product: 'products' };
const motif = (n: NewsLite): Motif => (n.product && motifByProduct[n.product]) || motifByCategory[n.category] || 'company';
const shot = (n: NewsLite) => (n.product ? productMedia(n.product).desktop : undefined);
const url = (n: NewsLite) => href(locale, `/news/${n.slug}`);
const iso = (d: Date) => d.toISOString().slice(0, 10);

const [lead, a, b, ...rest] = news;
const right = rest.slice(0, 3);
// highlights skip the six stories already in the mosaic, so no picture repeats on one screen
const inMosaic = new Set([lead, a, b, ...right].filter(Boolean).map((n) => n.slug));
const pool = news.filter((n) => n.featured && !inMosaic.has(n.slug));
// ...and no picture either: a screenshot already shown in the mosaic (posts about the same product share one)
// falls back to the post's own plate.
const shownImgs = new Set([shot(lead), a && shot(a)].filter(Boolean));
const highlights = (pool.length > 1 ? pool : news.filter((n) => !inMosaic.has(n.slug))).slice(0, 5).map((n) => {
  const img = shot(n) && !shownImgs.has(shot(n)) ? shot(n) : undefined;
  if (img) shownImgs.add(img);
  return { eyebrow: categories[n.category][locale], date: n.date, title: n.title, desc: n.description, href: url(n), motif: motif(n), seed: n.slug, img };
});
const cats = Object.keys(categories).filter((k) => news.some((n) => n.category === k));
// the two big topics are a segmented control, the long tail goes into a multi-select Filter
const segKeys = ['product', 'company'].filter((k) => cats.includes(k));
const filterKeys = cats.filter((k) => !segKeys.includes(k));
// related posts for the row expander: same product, then same topic, then newest; never the post itself
const related = (n: NewsLite) => news
  .filter((m) => m.slug !== n.slug)
  .map((m) => ({ m, s: (n.product && m.product === n.product ? 2 : 0) + (m.category === n.category ? 1 : 0) }))
  .sort((x, y) => y.s - x.s || +y.m.date - +x.m.date)
  .slice(0, 3)
  .map((x) => x.m);
const L = {
  latest: ui.latestNews,
  highlights: { en: 'Highlights', uz: 'Muhim', ru: 'Главное' },
  articles: { en: 'posts', uz: 'ta post', ru: 'публикаций' },
  title: { en: 'Title', uz: 'Sarlavha', ru: 'Заголовок' },
  summary: { en: 'Summary', uz: 'Qisqacha', ru: 'Кратко' },
  topic: { en: 'Topic', uz: 'Mavzu', ru: 'Тема' },
  date: { en: 'Date', uz: 'Sana', ru: 'Дата' },
  all: { en: 'All', uz: 'Barchasi', ru: 'Все' },
  filter: { en: 'Filter', uz: 'Filtr', ru: 'Фильтр' },
  removeFilter: { en: 'Remove filter', uz: 'Filtrni olib tashlash', ru: 'Убрать фильтр' },
  sort: { en: 'Sort', uz: 'Saralash', ru: 'Сортировка' },
  recent: { en: 'Most recent', uz: 'Eng yangilari', ru: 'Сначала новые' },
  oldest: { en: 'Oldest', uz: 'Eng eskilari', ru: 'Сначала старые' },
  az: { en: 'A–Z', uz: 'A–Z', ru: 'А–Я' },
  search: { en: 'Search news', uz: 'Yangiliklardan qidirish', ru: 'Поиск по новостям' },
  clearSearch: { en: 'Clear search', uz: 'Qidiruvni tozalash', ru: 'Очистить поиск' },
  details: { en: 'Details', uz: 'Batafsil', ru: 'Подробнее' },
  related: { en: 'Related', uz: 'Oʻxshash postlar', ru: 'Похожие публикации' },
  none: { en: 'Nothing matches these filters', uz: 'Bu filtrlarga mos yangilik yoʻq', ru: 'По этим фильтрам ничего нет' },
  noneHint: { en: 'Try another word or topic, or clear the filters to see every post.', uz: 'Boshqa soʻz yoki mavzuni tanlang yoki barcha postlarni koʻrish uchun filtrlarni tozalang.', ru: 'Попробуйте другое слово или тему либо сбросьте фильтры, чтобы увидеть все публикации.' },
  clear: { en: 'Clear filters', uz: 'Filtrlarni tozalash', ru: 'Сбросить фильтры' },
  more: { en: 'See more', uz: 'Yana koʻrsatish', ru: 'Показать ещё' },
  prev: { en: 'Previous', uz: 'Oldingi', ru: 'Назад' },
  next: { en: 'Next', uz: 'Keyingi', ru: 'Вперёд' },
  band: { en: 'Contact us or download our press kit', uz: 'Biz bilan bogʻlaning yoki press-kitni yuklab oling', ru: 'Свяжитесь с нами или скачайте пресс-кит' },
};
const sortOptions = [{ value: 'new', label: L.recent[locale] }, { value: 'old', label: L.oldest[locale] }, { value: 'az', label: L.az[locale] }];
const band = [
  { icon: 'arrow-up-right' as const, title: pageByKey['contact'].title, sub: { en: 'Press and partnerships', uz: 'Matbuot va hamkorlik', ru: 'Пресса и партнёрство' }, href: '/contact' },
  { icon: 'download' as const, title: pageByKey['brand'].title, sub: { en: 'Logos, colours, film', uz: 'Logotip, ranglar, film', ru: 'Логотипы, цвета, фильм' }, href: '/brand' },
  { icon: 'check' as const, title: pageByKey['security'].title, sub: { en: 'Report a vulnerability', uz: 'Zaiflik haqida xabar bering', ru: 'Сообщить об уязвимости' }, href: '/security' },
];
---
<div class="nx">
  <section class="container page-top" aria-labelledby="nx-l">
    <div class="rule-row"><h1 class="t-caption-bold" id="nx-l">{L.latest[locale]}</h1><span class="t-caption fg-3">{formatDate(lead.date, locale)}</span></div>
    <div class="nx__mosaic">
      <div class="nx__col nx__col--l">
        {[a, b].filter(Boolean).map((n, k) => (
          <article class="nx__story">
            <p class="nx__meta t-caption"><span>{categories[n.category][locale]}</span><time datetime={iso(n.date)}>{formatDate(n.date, locale)}</time></p>
            {k === 0 && <a class="nx__thumb" href={url(n)} tabindex="-1" aria-hidden="true">{shot(n) ? <img src={shot(n)} alt="" width="1512" height="945" loading="lazy" decoding="async" /> : <Plate motif={motif(n)} seed={n.slug} ratio="16/9" />}</a>}
            <h2 class="t-headline-5"><a class="nx__a" href={url(n)}>{n.title}</a></h2>
            <p class="t-body-4 fg-2 nx__desc">{n.description}</p>
          </article>
        ))}
      </div>
      <article class="nx__lead">
        <p class="nx__meta t-caption"><span>{categories[lead.category][locale]}</span><time datetime={iso(lead.date)}>{formatDate(lead.date, locale)}</time></p>
        <a class="nx__media" href={url(lead)} tabindex="-1" aria-hidden="true">
          {shot(lead) ? <img src={shot(lead)} alt="" width="1512" height="945" decoding="async" fetchpriority="high" /> : <Plate motif={motif(lead)} seed={lead.slug} ratio="16/9" />}
        </a>
        <h2 class="t-headline-3 nx__lead-title"><a class="nx__a" href={url(lead)}>{lead.title}</a></h2>
        <p class="t-body-3 fg-2 nx__desc">{lead.description}</p>
      </article>
      <div class="nx__col nx__col--r">
        {right.map((n) => (
          <article class="nx__story nx__story--text">
            <p class="nx__meta t-caption"><span>{categories[n.category][locale]}</span><time datetime={iso(n.date)}>{formatDate(n.date, locale)}</time></p>
            <h2 class="t-headline-5"><a class="nx__a" href={url(n)}>{n.title}</a></h2>
            <p class="t-body-4 fg-2 nx__desc">{n.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {highlights.length > 1 && (
    <section class="container section-lg" aria-labelledby="nx-h">
      <div class="rule-row"><h2 class="t-caption-bold" id="nx-h">{L.highlights[locale]}</h2></div>
      <div class="nx__hl"><FeatureCarousel locale={locale} label={L.highlights[locale]} items={highlights} cta={ui.readPost[locale]} prevLabel={L.prev[locale]} nextLabel={L.next[locale]} /></div>
    </section>
  )}

  <section class="container section-lg" data-ntable aria-labelledby="nx-all">
    <div class="nx__head">
      <h2 class="t-headline-2" id="nx-all">{groups.news[locale]}</h2>
      {segKeys.length > 0 && (
        <div class="nx__seg" role="group" aria-label={ui.filterNews[locale]}>
          <button type="button" class="nx__seg-b" data-nt-seg="" aria-pressed="true">{L.all[locale]}</button>
          {segKeys.map((k) => <button type="button" class="nx__seg-b" data-nt-seg={k} aria-pressed="false">{categories[k][locale]}</button>)}
        </div>
      )}
    </div>
    <div class="nx__bar">
      <p class="nx__count t-caption"><span data-nt-count>{news.length}</span> {L.articles[locale]}</p>
      <div class="nx__tools">
        {filterKeys.length > 0 && (
          <div class="nx__tool nx__tool--filter" data-nt-filter>
            <Select label={L.filter[locale]} placeholder={L.filter[locale]} multiple options={filterKeys.map((k) => ({ value: k, label: categories[k][locale] }))} />
          </div>
        )}
        {filterKeys.length > 0 && (
          <div class="nx__chips">
            {filterKeys.map((k) => (
              <button type="button" class="nx__chip" data-nt-chip={k} aria-label={`${L.removeFilter[locale]}: ${categories[k][locale]}`} hidden>
                {categories[k][locale]}<Icon name="close" size={12} />
              </button>
            ))}
          </div>
        )}
        <div class="nx__tool nx__tool--sort" data-nt-sort><Select label={L.sort[locale]} options={sortOptions} value="new" align="end" /></div>
        <div class="nx__q">
          <Icon name="search" size={14} />
          <input type="search" data-nt-q placeholder={L.search[locale]} aria-label={L.search[locale]} autocomplete="off" />
          <button type="button" class="nx__qx" data-nt-qx aria-label={L.clearSearch[locale]} hidden><Icon name="close" size={12} /></button>
        </div>
      </div>
    </div>
    <div class="nx__th" aria-hidden="true">
      <span>{L.title[locale]}</span><span>{L.summary[locale]}</span><span>{L.topic[locale]}</span><span>{L.date[locale]}</span><span></span>
    </div>
    <ul class="nx__list" role="list" aria-labelledby="nx-all" data-nt-body>
      {news.map((n) => (
        <li class="nx__item" data-key={n.category} data-date={iso(n.date)} data-title={n.title} data-text={`${n.title} ${n.description}`.toLowerCase()}>
          <div class="nx__row">
            <a class="nx__rowlink" href={url(n)} aria-labelledby={`nt-${n.slug}`}></a>
            <span class="nx__t" data-pan-cell><span class="nx__pan" id={`nt-${n.slug}`}>{n.title}</span></span>
            <span class="nx__d" data-pan-cell><span class="nx__pan">{n.description}</span></span>
            <span class="nx__c">{categories[n.category][locale]}</span>
            <span class="nx__dt"><time datetime={iso(n.date)}>{formatDate(n.date, locale)}</time></span>
            <button type="button" class="nx__xb" aria-expanded="false" aria-controls={`nx-${n.slug}`} aria-label={`${L.details[locale]}: ${n.title}`}>
              <span class="nx__pill" aria-hidden="true"><span class="nx__dots"><i></i><i></i><i></i></span><Icon name="close" size={10} /></span>
            </button>
          </div>
          <div class="nx__x" id={`nx-${n.slug}`} inert>
            <div class="nx__x-in">
              <p class="nx__x-meta t-caption"><span>{categories[n.category][locale]}</span><time datetime={iso(n.date)}>{formatDate(n.date, locale)}</time></p>
              <p class="t-body-3 nx__x-desc">{n.description}</p>
              <h3 class="t-caption-bold nx__x-h">{L.related[locale]}</h3>
              <ul class="nx__rel" role="list">
                {related(n).map((m) => (
                  <li><a class="nx__rc" href={url(m)}>
                    <span class="nx__rc-meta t-caption">{categories[m.category][locale]} · <time datetime={iso(m.date)}>{formatDate(m.date, locale)}</time></span>
                    <span class="nx__rc-t">{m.title}</span>
                  </a></li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="empty" data-nt-none role="status" hidden><p class="t-headline-5">{L.none[locale]}</p><p class="t-body-4 fg-2">{L.noneHint[locale]}</p><button type="button" class="btn btn--secondary btn--sm" data-nt-clear>{L.clear[locale]}</button></div>
    <div class="nx__more"><button type="button" class="btn btn--secondary btn--small btn--rounded btn--trailing" data-nt-more hidden>{L.more[locale]}<Icon name="arrow-down" size={14} /></button></div>
  </section>

  <section class="nx__band theme-slate" aria-labelledby="nx-b">
    <div class="container nx__band-in">
      <h2 class="t-headline-4" id="nx-b">{L.band[locale]}</h2>
      <ul class="nx__tiles" role="list">
        {band.map((t) => (
          <li><a class="nx__tile" href={href(locale, t.href)}>
            <Icon name={t.icon} size={16} />
            <span class="nx__tile-t">{t.title[locale]}</span>
            <span class="nx__tile-s t-caption">{t.sub[locale]}</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</div>

<script>
  // The news table: segmented group (?group=product|company), multi-select Filter for the other topics
  // (?category=a,b), sort (?sort=new|old|az), search, "See more", row expanders and panning text for clipped cells.
  // Old links use ?group=<any topic>; a topic that is not a segment opens as a Filter choice instead.
  const PER = 24;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const canPan = matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)');
  const EASE = 'cubic-bezier(.215, .61, .355, 1)';

  document.querySelectorAll<HTMLElement>('[data-ntable]').forEach((root) => {
    const body = root.querySelector<HTMLElement>('[data-nt-body]')!;
    const rows = [...body.children] as HTMLElement[];
    const segs = [...root.querySelectorAll<HTMLButtonElement>('[data-nt-seg]')];
    const segKeys = segs.map((b) => b.dataset.ntSeg ?? '');
    const filterSel = root.querySelector<HTMLElement>('[data-nt-filter] [data-select]');
    const filterKeys = filterSel ? [...filterSel.querySelectorAll<HTMLElement>('[role="option"]')].map((o) => o.dataset.value!) : [];
    const sortSel = root.querySelector<HTMLElement>('[data-nt-sort] [data-select]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-nt-chip]')];
    const q = root.querySelector<HTMLInputElement>('[data-nt-q]')!;
    const qx = root.querySelector<HTMLButtonElement>('[data-nt-qx]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-nt-more]')!;
    const none = root.querySelector<HTMLElement>('[data-nt-none]')!;
    const count = root.querySelector<HTMLElement>('[data-nt-count]');
    const lang = document.documentElement.lang || 'en';

    const state = { group: '', cats: [] as string[], sort: 'new' };
    let shown = PER;
    const params = new URL(location.href).searchParams;
    const g = params.get('group') ?? '';
    if (g && segKeys.includes(g)) state.group = g;
    else if (filterKeys.includes(g)) state.cats = [g];
    const fromUrl = (params.get('category') ?? '').split(',').filter((k) => filterKeys.includes(k));
    if (fromUrl.length) { state.cats = [...new Set([...state.cats, ...fromUrl])]; state.group = ''; }
    const s = params.get('sort');
    if (s === 'old' || s === 'az') state.sort = s;

    const setSelect = (el: HTMLElement | null, value: string | string[]) => el?.dispatchEvent(new CustomEvent('select:set', { detail: { value } }));
    const saveUrl = () => {
      const u = new URL(location.href);
      if (state.group) u.searchParams.set('group', state.group); else u.searchParams.delete('group');
      if (state.cats.length) u.searchParams.set('category', state.cats.join(',')); else u.searchParams.delete('category');
      if (state.sort !== 'new') u.searchParams.set('sort', state.sort); else u.searchParams.delete('sort');
      history.replaceState(history.state, '', u);
    };

    // panning text: mark the cells whose text is clipped, then pan them at 80px/s while the pointer is on the row
    const measure = () => rows.forEach((r) => {
      if (r.hidden) return;
      r.querySelectorAll<HTMLElement>('[data-pan-cell]').forEach((c) => c.toggleAttribute('data-clip', c.scrollWidth - c.clientWidth > 1));
    });
    const pans = new Map<HTMLElement, number>();
    const stopPan = (r: HTMLElement) => {
      cancelAnimationFrame(pans.get(r) ?? 0);
      pans.delete(r);
      r.querySelectorAll<HTMLElement>('[data-pan-cell]').forEach((c) => { c.removeAttribute('data-pan'); (c.firstElementChild as HTMLElement).style.transform = ''; });
    };
    const startPan = (r: HTMLElement) => {
      const cells = [...r.querySelectorAll<HTMLElement>('[data-pan-cell][data-clip]')]
        .map((c) => ({ c, span: c.firstElementChild as HTMLElement, d: c.scrollWidth - c.clientWidth }))
        .filter((x) => x.d > 1);
      if (!cells.length) return;
      const t0 = performance.now();
      cells.forEach(({ c }) => { c.dataset.pan = 'run'; });
      const step = (now: number) => {
        let busy = false;
        cells.forEach(({ c, span, d }) => {
          const x = Math.min(d, ((now - t0) / 1000) * 80);
          span.style.transform = `translateX(${-x}px)`;
          if (x < d) busy = true; else c.dataset.pan = 'end';
        });
        if (busy) pans.set(r, requestAnimationFrame(step)); else pans.delete(r);
      };
      pans.set(r, requestAnimationFrame(step));
    };

    const render = () => {
      const term = q.value.trim().toLowerCase();
      const order = [...rows].sort((x, y) => {
        if (state.sort === 'az') return (x.dataset.title ?? '').localeCompare(y.dataset.title ?? '', lang);
        const c = (x.dataset.date ?? '').localeCompare(y.dataset.date ?? '');
        return state.sort === 'old' ? c : -c;
      });
      order.forEach((r) => body.append(r));
      const want = state.cats.length ? state.cats : state.group ? [state.group] : null;
      const hits = order.filter((r) => (!want || want.includes(r.dataset.key ?? '')) && (!term || (r.dataset.text ?? '').includes(term)));
      order.forEach((r) => { r.hidden = true; });
      hits.forEach((r, k) => { r.hidden = k >= shown; });
      if (count) count.textContent = String(hits.length);
      none.hidden = hits.length > 0;
      more.hidden = hits.length <= shown;
      qx.hidden = !q.value;
      requestAnimationFrame(measure);
    };
    const sync = (save = true) => {
      segs.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.ntSeg ?? '') === state.group)));
      chips.forEach((c) => { c.hidden = !state.cats.includes(c.dataset.ntChip ?? ''); });
      if (save) saveUrl();
      render();
    };

    segs.forEach((b) => b.addEventListener('click', () => {
      state.group = b.dataset.ntSeg ?? '';
      // a segment and a Filter topic are one dimension and would always intersect to nothing, so they replace each other
      if (state.group && state.cats.length) { state.cats = []; setSelect(filterSel, []); }
      shown = PER; sync();
    }));
    filterSel?.addEventListener('select:change', (e) => {
      state.cats = [...((e as CustomEvent).detail.value as string[])];
      if (state.cats.length) state.group = '';
      shown = PER; sync();
    });
    chips.forEach((c) => c.addEventListener('click', () => {
      state.cats = state.cats.filter((k) => k !== c.dataset.ntChip);
      setSelect(filterSel, state.cats);
      shown = PER; sync();
      (chips.find((x) => !x.hidden) ?? filterSel?.querySelector<HTMLElement>('.sel__trigger'))?.focus();
    }));
    sortSel?.addEventListener('select:change', (e) => { state.sort = String((e as CustomEvent).detail.value || 'new'); sync(); });
    q.addEventListener('input', () => { shown = PER; render(); });
    qx.addEventListener('click', () => { q.value = ''; shown = PER; render(); q.focus(); });
    root.querySelector('[data-nt-clear]')?.addEventListener('click', () => {
      state.group = ''; state.cats = []; state.sort = 'new'; q.value = ''; shown = PER;
      setSelect(filterSel, []); setSelect(sortSel, 'new');
      sync();
      q.focus();
    });
    more.addEventListener('click', () => { shown += PER; render(); });

    rows.forEach((r) => {
      r.addEventListener('pointerenter', (e) => { if (canPan.matches && e.pointerType === 'mouse') startPan(r); });
      r.addEventListener('pointerleave', () => stopPan(r));
      // expander: height 0 -> scrollHeight in .35s, back in .3s; collapsed details are inert, so only the row link and
      // the button take focus
      const btn = r.querySelector<HTMLButtonElement>('.nx__xb')!;
      const panel = r.querySelector<HTMLElement>('.nx__x')!;
      panel.addEventListener('transitionend', (e) => { if (e.propertyName === 'height' && r.classList.contains('is-open')) panel.style.height = 'auto'; });
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        r.classList.toggle('is-open', open);
        panel.inert = !open;
        panel.style.transition = 'none';
        if (reduce.matches) { panel.style.height = open ? 'auto' : '0px'; return; }
        panel.style.height = open ? '0px' : `${panel.scrollHeight}px`;
        void panel.offsetHeight;
        panel.style.transition = `height ${open ? '.35s' : '.3s'} ${EASE}`;
        panel.style.height = open ? `${panel.scrollHeight}px` : '0px';
      });
    });

    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(measure, 150); });
    // the listboxes may wire up after this script runs, so their initial value is set on the next frame
    requestAnimationFrame(() => { setSelect(filterSel, state.cats); setSelect(sortSel, state.sort); });
    // an old ?group=<topic> link is rewritten to ?category=<topic>; otherwise the URL is left as it came
    sync(filterKeys.includes(g));
  });
</script>

