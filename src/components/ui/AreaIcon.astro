---
/* Area marks: one original glyph family in the text colour (currentColor), 40px by default.
   While a mark is on screen it loops: its subject, resolved into flat diamond facets -> an ink drop -> cells growing
   out of the drop -> a second view of the subject -> back. The frames live in marks/glyphs.mjs and the keyframes in the
   generated marks/marks.css (CSS `d` morph, cubic-bezier(.65, 0, .35, 1), 12 s). A small observer runs the loop only
   while the mark is in view; hover never starts it. Reduced motion, and browsers without CSS `d`, show the hero frame. */
import { hero } from './marks/glyphs.mjs';
import './marks/marks.css';
export type AreaName = 'agents' | 'language' | 'infrastructure' | 'supply-chain' | 'interfaces' | 'faith-society' | 'digital-assets' | 'engineering' | 'research' | 'news' | 'changelog';
interface Props { name: AreaName; size?: number; still?: boolean }
const { name, size = 40, still = false } = Astro.props;
const order: AreaName[] = ['agents', 'language', 'infrastructure', 'supply-chain', 'interfaces', 'faith-society', 'digital-assets', 'engineering', 'research', 'news', 'changelog'];
// neighbours in a strip start a little apart, so the family breathes instead of marching in step
const delay = `${(((order.indexOf(name) * 7) % 11) * 0.55).toFixed(2)}s`;
---
<svg class:list={['aicon', `aicon--${name}`]} viewBox="0 0 40 40" width={size} height={size} aria-hidden="true" focusable="false" data-morph={still ? undefined : ''} style={`--mk-delay:${delay}`}>
  <path class="aicon__p" d={hero(name)} />
</svg>

<script>
  // Run the morph only while a mark is on screen; off screen it holds its current frame.
  const marks = document.querySelectorAll<SVGElement>('.aicon[data-morph]');
  if (marks.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.target.toggleAttribute('data-on', e.isIntersecting);
    });
    marks.forEach((m) => io.observe(m));
  }
</script>

<style>
  .aicon { flex: none; display: inline-block; vertical-align: middle; }
  .aicon__p { fill: currentColor; }
  @media (prefers-reduced-motion: no-preference) {
    .aicon[data-morph] .aicon__p {
      animation-duration: 12s; animation-iteration-count: infinite; animation-timing-function: cubic-bezier(.65, 0, .35, 1);
      animation-delay: var(--mk-delay, 0s); animation-play-state: paused;
    }
    .aicon[data-on] .aicon__p { animation-play-state: running; }
  }
  @media (forced-colors: active) { .aicon__p { fill: CanvasText; } }
</style>
