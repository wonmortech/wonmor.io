---
/* Heading text that rolls up on hover/focus of the nearest ".has-swap" ancestor: the visible line slides out and an
   identical line slides in from below (a duplicate hidden from assistive tech). Reduced motion: no roll. */
interface Props { text: string; class?: string }
const { text, class: cls } = Astro.props;
---
<span class:list={['swap', cls]}><span class="swap__a">{text}</span><span class="swap__b" aria-hidden="true">{text}</span></span>

<style>
  .swap { position: relative; display: inline-grid; overflow: hidden; vertical-align: top; padding-bottom: .08em; margin-bottom: -.08em; }
  .swap__a, .swap__b { grid-area: 1 / 1; }
  .swap__b { transform: translateY(105%); }
  @media (prefers-reduced-motion: no-preference) {
    .swap__a, .swap__b { transition: transform .55s var(--ease-out-quart); }
    :global(.has-swap:is(:hover, :focus-visible)) .swap__a { transform: translateY(-105%); }
    :global(.has-swap:is(:hover, :focus-visible)) .swap__b { transform: translateY(0); }
  }
</style>
