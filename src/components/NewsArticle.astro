---
/* Article page (DESIGN.md §5.11): centred sans title, serif reading column, meta panel on the right.
   3+ sections: a sticky section bar; wide screens: a sticky related rail under the meta, otherwise related posts after the text. */
import { getCollection, render } from 'astro:content';
import Icon from './Icon.astro';
import SectionBar from './article/SectionBar.astro';
import Related, { type NewsLite } from './article/Related.astro';
import './article/figures.css';
import { formatDate, href, type Locale } from '../i18n/config';
import { categories } from '../i18n/home';
import { ui } from '../i18n/ui';

interface Props { locale: Locale; title: string; description: string; date: Date; category: string; product?: string;
  links: { label: string; text: string; href: string; kind: 'external' | 'download' | 'internal' }[]; }
const { locale, title, description, date, category, links } = Astro.props;

/* This post's entry (the page passes its fields, not its id): its sections, product, and the related posts —
   same product first, then same category, then the newest; newest first; never this post. */
const all = (await getCollection('news', (e) => e.id.endsWith(`/${locale}`))).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const self = all.find((e) => e.data.title === title && e.data.date.getTime() === date.getTime());
const product = Astro.props.product ?? self?.data.product;
const toc = self ? (await render(self)).headings.filter((h) => h.depth === 2) : [];
const hasBar = toc.length >= 3;
const rank = (e: (typeof all)[number]) => (product && e.data.product === product ? 2 : 0) + (e.data.category === category ? 1 : 0);
const related: NewsLite[] = all.filter((e) => e !== self).sort((a, b) => rank(b) - rank(a)).slice(0, 2)
  .map((e) => ({ slug: e.id.split('/')[0], title: e.data.title, description: e.data.description, date: e.data.date, category: e.data.category, links: e.data.links }));
const moreHref = `${href(locale, '/news')}?group=${category}`;
---
<article class="art">
  <header class="container art__head page-top">
    <p class="t-caption fg-3"><a class="link-quiet" href={href(locale, '/news')}>{categories[category][locale]}</a> · <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, locale)}</time></p>
    <h1 class="art__title">{title}</h1>
    <p class="art__dek t-body-1 fg-2">{description}</p>
  </header>
  <div class:list={['art__main', { 'has-secbar': hasBar }]}>
  {hasBar && <SectionBar locale={locale} headings={toc} />}
  <div class="container art__grid">
    <div class="art__body prose"><slot /></div>
    <div class="art__side">
    <aside class="art__meta t-caption" aria-label={ui.published[locale]}>
      <dl>
        <div><dt>{ui.published[locale]}</dt><dd>{formatDate(date, locale)}</dd></div>
        <div><dt>{ui.category[locale]}</dt><dd>{categories[category][locale]}</dd></div>
        {links.map((l) => (
          <div><dt>{l.label}</dt><dd><a class="link-underline" href={l.href} target={l.kind === 'internal' ? undefined : '_blank'} rel={l.kind === 'internal' ? undefined : 'noopener'}>{l.text}{l.kind !== 'internal' && <span class="sr-only"> {ui.external[locale]}</span>}</a>{' '}<Icon name={l.kind === 'download' ? 'download' : l.kind === 'internal' ? 'arrow-right' : 'arrow-up-right'} size={12} /></dd></div>
        ))}
      </dl>
    </aside>
    <Related locale={locale} variant="rail" kind="news" posts={related} moreHref={moreHref} />
    </div>
  </div>
  </div>
  <Related locale={locale} variant="section" kind="news" posts={related} moreHref={moreHref} />
</article>

<style>
  .art__head { display: grid; justify-items: center; text-align: center; gap: 20px; padding-bottom: 48px; }
  .art__title { font: 700 clamp(30px, calc(30px + 18 * ((100vw - 390px) / 1530)), 48px)/1.12 var(--sans); letter-spacing: -.024em; max-width: 22ch; text-wrap: balance; }
  .art__dek { max-width: 36em; }
  .art__grid { display: grid; gap: 40px; padding-bottom: var(--section-spacer-lg); }
  .art__grid > * { min-width: 0; }
  .prose :global(pre) { margin: 1.5em 0; padding: 16px 18px; border-radius: 12px; border: 1px solid var(--theme-border-secondary); overflow-x: auto; font: 400 13.5px/1.65 var(--mono); }
  .prose :global(pre code) { font: inherit; background: none; border: 0; padding: 0; }
  @media (min-width: 1024px) {
    .art__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gutter); }
    .art__body { grid-column: 4 / span 6; }
    .art__side { grid-column: 11 / span 2; align-self: stretch; }
  }
  .art__body { max-width: var(--reading-width); width: 100%; margin-inline: auto; }
  .art__meta dl > div { display: grid; gap: 2px; padding: 12px 0; border-top: 1px solid var(--theme-border-secondary); }
  .art__meta dt { color: var(--theme-foreground-primary); }
  .art__meta dd { color: var(--theme-foreground-tertiary); display: flex; align-items: center; gap: 4px; }
  /* links in the meta rail sit close together; 32px rows keep each tap target clear of its neighbour */
  .art__meta dd a { display: inline-flex; align-items: center; min-height: 32px; }

  .prose :global(p), .prose :global(li) { font: 400 clamp(17px, calc(17px + 2 * ((100vw - 390px) / 1530)), 19px)/1.6 var(--serif); font-variation-settings: 'opsz' 16; color: var(--theme-foreground-primary); text-wrap: pretty; }
  .prose :global(p + p) { margin-top: 1.1em; }
  .prose :global(h2) { font: 700 clamp(20px, calc(20px + 4 * ((100vw - 390px) / 1530)), 24px)/1.25 var(--sans); letter-spacing: -.01em; margin: 2em 0 .7em; }
  .prose :global(ul) { padding-left: 1.2em; margin: 1em 0; display: grid; gap: .5em; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(a) { text-decoration: underline; text-decoration-thickness: 1.3px; text-underline-offset: .2em; }
  .prose :global(code) { font: 400 .86em/1 var(--mono); background: var(--theme-background-secondary); border: 1px solid var(--theme-border-secondary); padding: .12em .35em; border-radius: 4px; }
</style>
