---
/* Wonmor illustration plates: our own image style, drawn in code.
   Every plate is a flat field of colour, a fine lattice and one emblem for its subject (seven diamonds for the charter,
   stacked plates for infrastructure, and so on), with a second, larger form printed behind it like an overprint:
   a block, a disc, a diamond, or a form taken from Uzbek craft and building (a girih star, Tashkent facade panels,
   a Samarkand dome, a suzani medallion, a mihrab arch). Colours come from theme tokens, so a plate follows all themes.

   Seeding: pass `seed` (a post slug) and a hash of it picks the tone, the background form and its orientation, the
   lattice and its density, and where the emblem sits, so two posts that share a motif do not look alike. The root
   carries data-art="<motif>:<variant>:<tone>" (and data-seed); tools/check-art.mjs fails the build when two different
   seeds on one page get the same signature. Without a seed the composition is fixed per motif.
   Hover (fine pointers only) redraws the emblem's lines and lights the lattice; nothing scales. */
export type Motif =
  | 'charter' | 'sponsorship' | 'research' | 'careers' | 'missing' | 'agents' | 'language' | 'infrastructure'
  | 'supply-chain' | 'interfaces' | 'faith' | 'assets' | 'engineering' | 'products' | 'company' | 'open-source'
  | 'security' | 'transparency' | 'release' | 'legal' | 'events' | 'timeline' | 'brand' | 'contact' | 'founder' | 'useful'
  | 'girih' | 'suzani' | 'facade' | 'keycaps' | 'dome';
export type Tone = 'ink' | 'blue' | 'mist' | 'sand' | 'clay' | 'teal';
interface Props { motif: Motif; ratio?: '4/5' | '16/9' | '1/1'; tone?: Tone; seed?: string; idle?: boolean; class?: string }
const { motif, ratio = '4/5', tone, seed, idle = false, class: cls } = Astro.props;

const toneOf: Record<Motif, Tone> = {
  charter: 'ink', sponsorship: 'sand', research: 'blue', careers: 'mist', missing: 'mist', agents: 'ink', language: 'sand',
  infrastructure: 'blue', 'supply-chain': 'teal', interfaces: 'ink', faith: 'clay', assets: 'blue', engineering: 'ink',
  products: 'mist', company: 'blue', 'open-source': 'teal', security: 'ink', transparency: 'mist', release: 'blue',
  legal: 'sand', events: 'clay', timeline: 'ink', brand: 'blue', contact: 'sand', founder: 'ink', useful: 'sand',
  girih: 'teal', suzani: 'clay', facade: 'mist', keycaps: 'sand', dome: 'teal',
};
const tones: Tone[] = ['ink', 'blue', 'mist', 'sand', 'clay', 'teal'];

// FNV-1a over the seed, then a murmur-style finaliser per draw, so every choice gets its own independent bits.
const fnv = (s: string) => { let x = 0x811c9dc5; for (const c of s) { x ^= c.codePointAt(0)!; x = Math.imul(x, 0x01000193) >>> 0; } return x; };
const h = fnv(seed ?? `motif:${motif}`);
const pick = (i: number, n: number) => {
  let x = (h ^ Math.imul(i + 1, 0x9e3779b9)) >>> 0;
  x ^= x >>> 16; x = Math.imul(x, 0x85ebca6b) >>> 0; x ^= x >>> 13; x = Math.imul(x, 0xc2b2ae35) >>> 0; x ^= x >>> 16;
  return (x >>> 0) % n;
};
const t: Tone = tone ?? (seed ? tones[pick(0, tones.length)] : toneOf[motif]);
const FIELDS = ['block', 'disc', 'diamond', 'girih', 'facade', 'dome', 'suzani', 'arch'] as const;
type Field = (typeof FIELDS)[number];
const field: Field = FIELDS[pick(1, FIELDS.length)];
const orient = pick(2, 4); // bit 0 mirrors the background form left/right, bit 1 top/bottom
const LATTICES = ['dots', 'grid', 'cross'] as const;
const lat = LATTICES[pick(3, 3)];
const cell = [20, 28][pick(4, 2)];
const px = pick(5, 3), py = pick(6, 3);
// letters, the brand sequence and pointers read one way only, so they never mirror
const flip = !['language', 'brand', 'company', 'interfaces', 'legal', 'contact', 'keycaps'].includes(motif) && pick(7, 2) === 1;
const ev = pick(8, 1 << 20); // emblem details (counts, which part is lit), read bit by bit by the emblems that vary

const W = ratio === '16/9' ? 640 : 400, H = ratio === '4/5' ? 500 : ratio === '16/9' ? 360 : 400;
const k = +((ratio === '4/5' ? 1.12 : ratio === '16/9' ? 0.84 : 1.02) * [1, 0.9, 0.8][px]).toFixed(3);
const sx = orient & 1 ? -1 : 1, sy = orient & 2 ? -1 : 1;
// the emblem steps away from the background form, never onto it
const ex = +(W / 2 - sx * [0, 0.07, 0.13][px] * W).toFixed(1), ey = +(H / 2 + [-0.04, 0, 0.04][py] * H).toFixed(1);

// d = diamond centred on (x, y) with half-diagonal r
const q = (n: number) => +n.toFixed(1);
const d = (x: number, y: number, r: number) => `M${q(x)} ${q(y - r)}L${q(x + r)} ${q(y)}L${q(x)} ${q(y + r)}L${q(x - r)} ${q(y)}Z`;
const pt = (r: number, a: number) => [+(r * Math.cos(a)).toFixed(1), +(r * Math.sin(a)).toFixed(1)] as const;
const ring = (r: number, n: number, off = 0) => Array.from({ length: n }, (_, i) => pt(r, (Math.PI * 2 * i) / n - Math.PI / 2 + off));
const rr = (x: number, y: number, w: number, h: number, r: number) => `M${x + r} ${y}h${w - 2 * r}a${r} ${r} 0 0 1 ${r} ${r}v${h - 2 * r}a${r} ${r} 0 0 1 ${-r} ${r}h${-(w - 2 * r)}a${r} ${r} 0 0 1 ${-r} ${-r}v${-(h - 2 * r)}a${r} ${r} 0 0 1 ${r} ${-r}z`;

// Each emblem: lines (stroked, redrawn on hover), fills (brand accent), soft (quiet fills), spin (accents on an orbit).
// Coordinates sit in a 240 x 240 box centred on 0, 0.
type Shape = { d: string; delay?: number };
type Emblem = { lines: Shape[]; fills?: Shape[]; soft?: Shape[]; spin?: Shape[]; code?: string };
const seven = [-72, -48, -24, 0, 24, 48, 72];

const E: Record<Motif, () => Emblem> = {
  // seven principles: a seal of one large diamond holding a column of seven
  charter: () => ({
    lines: [{ d: d(0, 0, 112) }, { d: 'M0 -112V112' }, ...seven.map((y, i) => ({ d: `M${-(46 - Math.abs(y) / 3)} ${y}H${46 - Math.abs(y) / 3}`, delay: i }))],
    fills: seven.map((y, i) => ({ d: d(0, y, 8), delay: i })),
  }),
  // where a self-funded studio's money goes: three columns of stacked diamonds on a base line
  sponsorship: () => ({
    lines: [{ d: 'M-110 100H110' }, ...([[-62, 3], [0, 5], [62, 2]] as const).flatMap(([x, n], c) => Array.from({ length: n }, (_, i) => ({ d: d(x, 82 - i * 34, 17), delay: c * 2 + i })))],
    fills: [{ d: d(0, 82 - 4 * 34, 17), delay: 6 }],
    soft: [{ d: d(-62, 82 - 2 * 34, 17) }, { d: d(62, 82 - 34, 17) }],
  }),
  // six research areas around one question
  research: () => {
    const n = ring(92, 6);
    return {
      lines: [{ d: `M${n.map(([x, y]) => `${x} ${y}`).join('L')}Z` }, ...n.map(([x, y], i) => ({ d: `M0 0L${x} ${y}`, delay: i })), ...n.map(([x, y], i) => ({ d: d(x, y, 11), delay: i }))],
      fills: [{ d: d(0, 0, 24) }],
    };
  },
  // an open door: a diamond frame opened on one side, a path of dots walking in
  careers: () => ({
    lines: [{ d: 'M0 -116L78 0L0 116' }, { d: 'M0 -116L-30 -70' }, { d: 'M0 116L-30 70' }],
    fills: [{ d: d(18, 0, 18) }],
    soft: [-100, -80, -60, -40, -20].map((x, i) => ({ d: d(x, 60 - i * 12, 4 + i), delay: i })),
  }),
  // 404: a lattice with one diamond gone
  missing: () => ({
    lines: [-1, 0, 1].flatMap((r) => [-1, 0, 1].filter((c) => !(r === 0 && c === 1)).map((c) => ({ d: d(c * 64, r * 64, 28), delay: r * 3 + c + 4 }))),
    soft: [-1, 0, 1].flatMap((r) => [-1, 0, 1].filter((c) => !(r === 0 && c === 1)).map((c) => ({ d: d(c * 64, r * 64, 12) }))),
    fills: [{ d: d(64, 0, 6) }],
  }),
  // agents: a core and its workers on a tilted orbit; the seed sets how many, the tilt and where they stand
  agents: () => {
    const n = 3 + (ev % 3), ti = (ev >> 2) % 5, oi = (ev >> 5) % 4, tilt = [-24, -12, 0, 12, 24][ti], a = (tilt * Math.PI) / 180;
    const x = q(96 * Math.cos(a)), y = q(96 * Math.sin(a));
    const at = (t: number) => { const u = 96 * Math.cos(t), w = 34 * Math.sin(t); return [q(u * Math.cos(a) - w * Math.sin(a)), q(u * Math.sin(a) + w * Math.cos(a))] as const; };
    return {
      code: `n${n}t${ti}o${oi}`,
      lines: [{ d: 'M-96 0a96 96 0 1 0 192 0a96 96 0 1 0 -192 0' }, { d: `M${-x} ${-y}a96 34 ${tilt} 1 0 ${q(2 * x)} ${q(2 * y)}a96 34 ${tilt} 1 0 ${q(-2 * x)} ${q(-2 * y)}`, delay: 2 }, { d: d(0, 0, 30), delay: 1 }],
      fills: [{ d: d(0, 0, 14) }],
      spin: Array.from({ length: n }, (_, i) => at(oi * (Math.PI / 10) + (i * Math.PI * 2) / n + Math.PI / 2)).map(([u, w]) => ({ d: d(u, w, 10) })),
    };
  },
  // language: keys of a keyboard, one pressed, with the okina (ʻ) the Uzbek alphabet needs on its neighbour
  language: () => {
    const layout = ev % 2, keys = [-1, 0].flatMap((r) => [-1, 0, 1].map((c) => [c * 76 - 34 + (layout && r < 0 ? 38 : 0) - (layout ? 19 : 0), r * 76 - 2] as const));
    const pressed = (ev >> 1) % 6, [ox, oy] = keys[(pressed + 1) % 6];
    return {
      code: `l${layout}k${pressed}`,
      lines: keys.map(([x, y], i) => ({ d: rr(x, y, 68, 68, 10), delay: i % 3 + (y < 0 ? 0 : 1) })),
      fills: [{ d: rr(keys[pressed][0], keys[pressed][1], 68, 68, 10) }],
      soft: [{ d: `M${ox + 30} ${oy + 48}c-10 -3 -14 -14 -8 -22c4 -6 12 -8 17 -5c-6 3 -8 9 -5 14c2 4 7 5 10 4c-3 7 -8 11 -14 9z` }],
    };
  },
  // infrastructure: stacked plates, one of them live
  infrastructure: () => {
    const n = 2 + (ev % 3), live = (ev >> 2) % n, gap = n === 4 ? 40 : 52, ys = Array.from({ length: n }, (_, i) => q((i - (n - 1) / 2) * gap));
    const plate = (y: number) => `M-104 ${y}L0 ${q(y - 44)}L104 ${y}L0 ${q(y + 44)}Z`, yb = ys[n - 1];
    return {
      code: `n${n}l${live}`,
      lines: [...ys.map((y, i) => ({ d: plate(y), delay: n - i })), { d: `M-104 ${yb}V${q(yb + 14)}L0 ${q(yb + 58)}L104 ${q(yb + 14)}V${yb}` }],
      fills: live === 0 ? [{ d: plate(ys[0]) }] : [{ d: d(0, ys[live], 12) }],
      soft: [...ys.filter((_, i) => i !== live && i !== 0).map((y) => ({ d: d(0, y, 8) })), ...(live ? [{ d: plate(ys[live]) }] : [])],
    };
  },
  // supply chain: linked diamonds, one verified
  'supply-chain': () => {
    const n = 3 + (ev % 3), ver = (ev >> 2) % n, step = [70, 56, 46][n - 3], r = [46, 40, 30][n - 3];
    const xs = Array.from({ length: n }, (_, i) => q((i - (n - 1) / 2) * step));
    return {
      code: `n${n}v${ver}`,
      lines: xs.map((x, i) => ({ d: d(x, q(x * 0.6), r), delay: i })),
      fills: [{ d: d(xs[ver], q(xs[ver] * 0.6), q(r * 0.4)) }],
      soft: xs.filter((_, i) => i !== ver).map((x) => ({ d: d(x, q(x * 0.6), q(r * 0.2)) })),
    };
  },
  // interfaces: a window with a pointer; the seed sets the lines, a sidebar and where the pointer is
  interfaces: () => {
    const nl = 2 + (ev % 3), pp = (ev >> 2) % 3, side = (ev >> 4) % 2, x0 = side ? -40 : -90;
    const ys = nl === 4 ? [-22, 2, 26, 50] : nl === 3 ? [-16, 12, 40] : [-10, 24];
    const [px0, py0] = [[58, 26], [-10, 34], [30, -18]][pp];
    return {
      code: `l${nl}p${pp}s${side}`,
      lines: [{ d: rr(-124, -84, 248, 168, 12) }, { d: side ? 'M-124 -52H124M-62 -52V84' : 'M-124 -52H124' }, ...ys.map((y, i) => ({ d: `M${x0} ${y}H${x0 + 70 + ((ev >> (6 + i * 2)) % 4) * 26}`, delay: i + 1 }))],
      fills: [{ d: `M${px0} ${py0}l44 18l-20 8l14 24l-10 6l-14 -24l-14 14z` }],
      soft: [{ d: d(-104, -68, 5) }, { d: d(-88, -68, 5) }, { d: d(-72, -68, 5) }],
    };
  },
  // faith and society: dtwin's 24-hour ring with the five prayer times marked, one of them now
  faith: () => {
    const inner = ev % 3, hi = (ev >> 2) % 5;
    const st = `M${Array.from({ length: 16 }, (_, i) => pt(i % 2 ? 30.6 : 40, -Math.PI / 2 + (i * Math.PI) / 8).join(' ')).join('L')}Z`;
    return {
      code: `i${inner}h${hi}`,
      lines: [{ d: 'M-100 0a100 100 0 1 0 200 0a100 100 0 1 0 -200 0' }, ...ring(1, 24).map(([x, y], i) => ({ d: `M${q(x * 84)} ${q(y * 84)}L${q(x * (i % 6 ? 90 : 74))} ${q(y * (i % 6 ? 90 : 74))}`, delay: i / 3 })),
        ...(inner === 1 ? [{ d: st, delay: 3 }] : inner === 2 ? [{ d: 'M-50 0a50 50 0 1 0 100 0a50 50 0 1 0 -100 0', delay: 3 }] : [])],
      fills: [5.3, 12.6, 16.1, 18.7, 20.1].map((hr, i) => { const [x, y] = pt(100, (Math.PI * 2 * hr) / 24 - Math.PI / 2); return { d: d(x, y, i === hi ? 15 : 9), delay: i }; }),
      soft: [{ d: d(0, 0, inner === 1 ? 12 : 18) }],
    };
  },
  // digital assets: a stack of coins under a diamond
  assets: () => {
    const n = 2 + (ev % 3), side = (ev >> 2) % 2, sh = (n - 3) * 15, ys = Array.from({ length: n }, (_, i) => 60 - i * 30 + sh), top = ys[n - 1];
    return {
      code: `n${n}s${side}`,
      lines: [...ys.map((y, i) => ({ d: `M-80 ${y}a80 26 0 1 0 160 0a80 26 0 1 0 -160 0`, delay: i })), { d: `M-80 ${top}V${ys[0]}M80 ${top}V${ys[0]}` }],
      fills: [{ d: side ? d(92, top - 56, 26) : d(0, top - 64, 36) }],
    };
  },
  // engineering: angle brackets around a diamond
  engineering: () => ({
    lines: [{ d: 'M-56 -80L-112 0L-56 80' }, { d: 'M56 -80L112 0L56 80', delay: 1 }, { d: 'M26 -100L-26 100', delay: 2 }],
    fills: [{ d: d(0, 0, 18) }],
  }),
  // products: a grid of tiles, each a product, one in focus
  products: () => ({
    lines: [-1, 0, 1].flatMap((r) => [-1, 0, 1].map((c) => ({ d: rr(c * 76 - 30, r * 76 - 30, 60, 60, 8), delay: r + c + 2 }))),
    fills: [{ d: d(0, 0, 20) }],
    soft: [{ d: d(-76, -76, 10) }, { d: d(76, 76, 10) }, { d: d(76, -76, 6) }],
  }),
  // company: the mark's story, a diamond above the W it becomes
  company: () => ({
    lines: [{ d: 'M-110 -30L-55 80L0 -30L55 80L110 -30' }, { d: 'M-90 -30H90', delay: 2 }],
    fills: [{ d: d(0, -78, 26) }],
  }),
  // open source: branches leaving a trunk
  'open-source': () => ({
    lines: [{ d: 'M-70 110V-110' }, { d: 'M-70 40C-70 0 60 20 60 -30V-74', delay: 1 }, { d: 'M-70 -10C-70 -40 0 -40 0 -74', delay: 2 }],
    fills: [{ d: d(60, -90, 16) }],
    soft: [{ d: d(-70, 110, 9) }, { d: d(-70, -110, 9) }, { d: d(0, -90, 9) }],
  }),
  // security: a shield shaped from the diamond, a keyhole inside
  security: () => ({
    lines: [{ d: 'M0 -116L96 -70V0C96 60 46 96 0 116C-46 96 -96 60 -96 0V-70Z' }, { d: 'M0 -84L66 -52V0C66 40 34 66 0 82C-34 66 -66 40 -66 0V-52Z', delay: 2 }],
    fills: [{ d: 'M0 -30a16 16 0 0 1 9 29l7 33h-32l7 -33a16 16 0 0 1 9 -29z' }],
  }),
  // transparency: nested diamonds you can see through
  transparency: () => ({
    lines: [112, 84, 56, 28].map((r, i) => ({ d: d(0, 0, r), delay: i })),
    fills: [{ d: d(0, 0, 12) }],
    soft: [{ d: d(0, -84, 6) }, { d: d(84, 0, 6) }, { d: d(0, 84, 6) }, { d: d(-84, 0, 6) }],
  }),
  // release levels: gates, a filled diamond for each one passed
  release: () => ({
    lines: [...[-80, 0, 80].map((x, i) => ({ d: `M${x - 26} 90V-50L${x} -80L${x + 26} -50V90`, delay: i })), { d: 'M-120 90H120' }],
    fills: [{ d: d(-80, 30, 14) }, { d: d(0, 30, 14), delay: 1 }],
    soft: [{ d: d(80, 30, 14) }],
  }),
  // legal: a document with lines and a seal
  legal: () => ({
    lines: [{ d: 'M-76 -112H40L84 -68V112H-76Z' }, { d: 'M40 -112V-68H84' }, ...[-56, -30, -4, 22].map((y, i) => ({ d: `M-50 ${y}H${i % 2 ? 30 : 56}`, delay: i }))],
    fills: [{ d: d(36, 74, 20) }],
  }),
  // events: a calendar with one day marked
  events: () => ({
    lines: [{ d: 'M-108 -84H108V100H-108Z' }, { d: 'M-108 -44H108' }, { d: 'M-60 -106V-64M60 -106V-64' }, ...[-1, 0, 1].map((c) => ({ d: `M${c * 54} -44V100`, delay: c + 2 })), { d: 'M-108 28H108', delay: 3 }],
    fills: [{ d: d(54, 64, 18) }],
  }),
  // timeline: a line of diamonds, the latest one filled
  timeline: () => ({
    lines: [{ d: 'M-120 0H120' }, ...[-96, -48, 0, 48].map((x, i) => ({ d: d(x, 0, 14), delay: i }))],
    fills: [{ d: d(96, 0, 18) }],
    soft: [-96, -48, 0, 48].map((x, i) => ({ d: rr(x - 2, i % 2 ? 22 : -58, 4, 36, 2) })),
  }),
  // brand: diamond, V, W, the three frames of the brand film
  brand: () => ({
    lines: [{ d: 'M-34 -40L-4 40L26 -40', delay: 2 }, { d: 'M40 -40L62 40L84 -40L106 40L128 -40', delay: 4 }],
    fills: [{ d: d(-92, 0, 30) }],
  }),
  // contact: two speech shapes meeting
  contact: () => ({
    lines: [{ d: 'M-90 -76h106a14 14 0 0 1 14 14v60a14 14 0 0 1 -14 14h-64l-30 26v-26h-12a14 14 0 0 1 -14 -14v-60a14 14 0 0 1 14 -14z' }, { d: 'M-10 22h100a14 14 0 0 1 14 14v52a14 14 0 0 1 -14 14h-14v24l-28 -24h-58a14 14 0 0 1 -14 -14v-52a14 14 0 0 1 14 -14z', delay: 2 }],
    fills: [{ d: d(40, 62, 12) }],
    soft: [{ d: d(-62, -32, 6) }, { d: d(-38, -32, 6) }, { d: d(-14, -32, 6) }],
  }),
  // founder: one diamond with the agents around it
  founder: () => ({
    lines: [{ d: 'M-96 0a96 96 0 1 0 192 0a96 96 0 1 0 -192 0' }, ...ring(96, 4, Math.PI / 4).map(([x, y], i) => ({ d: d(x, y, 12), delay: i + 1 }))],
    fills: [{ d: d(0, 0, 40) }],
  }),
  // useful first: a phone with the day on it
  useful: () => ({
    lines: [{ d: rr(-72, -116, 144, 232, 18) }, { d: 'M-40 -64H40', delay: 1 }, { d: 'M-40 -34H20', delay: 2 }, { d: 'M-40 -4H36', delay: 3 }],
    fills: [{ d: d(0, 56, 22) }],
  }),
  // girih: an eight-point star from two squares, its octagon and an inner star, the way Bukhara tilework repeats it
  girih: () => {
    const st = (R: number, off = 0) => `M${Array.from({ length: 16 }, (_, i) => pt(i % 2 ? R * 0.7654 : R, -Math.PI / 2 + off + (i * Math.PI) / 8).join(' ')).join('L')}Z`;
    const oc = ring(85.7, 8, Math.PI / 8), inner = ring(40, 8, Math.PI / 8);
    return {
      lines: [{ d: st(112) }, { d: `M${oc.map((p) => p.join(' ')).join('L')}Z`, delay: 1 }, { d: st(52, Math.PI / 8), delay: 2 }, { d: oc.map((p, i) => `M${p.join(' ')}L${inner[i].join(' ')}`).join(''), delay: 3 }],
      fills: [{ d: d(0, 0, 15) }],
      soft: ring(98, 8).map(([x, y]) => ({ d: d(x, y, 7) })),
    };
  },
  // suzani: an embroidered medallion, eight petals around a seed
  suzani: () => {
    const petal = (a: number) => { const [x1, y1] = pt(38, a), [x2, y2] = pt(98, a), [c1x, c1y] = pt(72, a - 0.36), [c2x, c2y] = pt(72, a + 0.36); return `M${x1} ${y1}Q${c1x} ${c1y} ${x2} ${y2}Q${c2x} ${c2y} ${x1} ${y1}Z`; };
    return {
      lines: [{ d: 'M-110 0a110 110 0 1 0 220 0a110 110 0 1 0 -220 0' }, { d: Array.from({ length: 8 }, (_, i) => petal(-Math.PI / 2 + (i * Math.PI) / 4)).join(''), delay: 1 }, { d: 'M-30 0a30 30 0 1 0 60 0a30 30 0 1 0 -60 0', delay: 2 }],
      fills: [{ d: d(0, 0, 16) }],
      soft: ring(80, 8, Math.PI / 8).map(([x, y]) => ({ d: `M${q(x - 7)} ${y}a7 7 0 1 0 14 0a7 7 0 1 0 -14 0` })),
    };
  },
  // facade: Tashkent modernist concrete, a wall of precast panels with a diamond grille in each
  facade: () => {
    const cols = [-1.5, -0.5, 0.5, 1.5], rows = [-1, 0, 1];
    const cells = rows.flatMap((r) => cols.map((c) => [c * 60, r * 70] as const));
    return {
      lines: [{ d: cells.map(([x, y]) => `M${x - 27} ${y - 32}h54v64h-54z`).join('') }, { d: cells.map(([x, y]) => d(x, y, 20)).join(''), delay: 2 }, { d: 'M-130 112H130', delay: 3 }],
      fills: [{ d: d(30, 0, 20) }],
      soft: [{ d: d(-90, -70, 20) }, { d: d(90, 70, 20) }],
    };
  },
  // keycaps: one key, an o with the okina, a diamond homing bump, and the edges of its neighbours
  keycaps: () => ({
    lines: [{ d: rr(-84, -84, 168, 168, 24) }, { d: rr(-64, -76, 128, 128, 16), delay: 1 }, { d: 'M-34 -14a22 22 0 1 0 44 0a22 22 0 1 0 -44 0', delay: 2 }, { d: `${rr(104, -84, 168, 168, 24)}${rr(-272, -84, 168, 168, 24)}`, delay: 3 }],
    fills: [{ d: d(-2, 36, 9) }],
    soft: [{ d: 'M26 -54c-8 -3 -11 -11 -6 -17c3 -5 9 -6 13 -4c-5 2 -6 7 -4 11c2 3 6 4 8 3c-2 5 -6 8 -11 7z' }],
  }),
  // dome: a Samarkand dome, ribbed, on a drum with arched windows and a finial
  dome: () => ({
    lines: [{ d: 'M-80 38C-84 -14 -26 -40 -6 -88L0 -100L6 -88C26 -40 84 -14 80 38Z' }, { d: [-48, -16, 16, 48].map((x) => `M0 -94C${x * 0.5} -50 ${x * 1.2} -10 ${x} 38`).join(''), delay: 1 }, { d: 'M-80 38V110H80V38', delay: 2 }, { d: [-46, 0, 46].map((x) => `M${x - 11} 110V82Q${x} 64 ${x + 11} 82V110`).join(''), delay: 3 }],
    fills: [{ d: d(0, -114, 10) }],
    soft: [{ d: 'M-80 38C-84 -14 -26 -40 -6 -88L0 -100L6 -88C26 -40 84 -14 80 38Z' }],
  }),
};
const em = E[motif]();
const variant = `${field}.o${orient}.${lat}${cell}.p${px}${py}${flip ? "m" : ""}${em.code ? "." + em.code : ""}`;

// Background forms, drawn for the right or bottom of the plate and mirrored by `orient`.
// fill = the flat overprint, cut = lines printed back in the ground colour.
const f1 = (n: number) => +n.toFixed(1);
const star16 = (cx: number, cy: number, R: number, off = 0) => `M${Array.from({ length: 16 }, (_, i) => { const r = i % 2 ? R * 0.7654 : R, a = -Math.PI / 2 + off + (i * Math.PI) / 8; return `${f1(cx + r * Math.cos(a))} ${f1(cy + r * Math.sin(a))}`; }).join('L')}Z`;
const circle = (cx: number, cy: number, r: number) => `M${f1(cx - r)} ${f1(cy)}a${f1(r)} ${f1(r)} 0 1 0 ${f1(2 * r)} 0a${f1(r)} ${f1(r)} 0 1 0 ${f1(-2 * r)} 0`;
const pointed = (cx: number, w: number, ys: number, close: boolean) => `M${f1(cx - w)} ${H}V${f1(ys)}A${f1(2 * w)} ${f1(2 * w)} 0 0 1 ${f1(cx)} ${f1(ys - 1.732 * w)}A${f1(2 * w)} ${f1(2 * w)} 0 0 1 ${f1(cx + w)} ${f1(ys)}V${H}${close ? 'Z' : ''}`;
const F: Record<Field, () => { fill: string; cut?: string }> = {
  block: () => ({ fill: `M${f1(W * 0.62)} 0H${W}V${H}H${f1(W * 0.62)}Z`, cut: `M${f1(W * 0.62 + 14)} 0V${H}` }),
  disc: () => ({ fill: circle(W * 0.8, H * 0.84, H * 0.64), cut: circle(W * 0.8, H * 0.84, H * 0.42) }),
  diamond: () => ({ fill: d(f1(W * 0.84), f1(H * 0.5), f1(H * 0.74)), cut: d(f1(W * 0.84), f1(H * 0.5), f1(H * 0.48)) }),
  // girih: an eight-point star with a smaller star turned inside it
  girih: () => ({ fill: star16(W * 0.82, H * 0.2, H * 0.66), cut: star16(W * 0.82, H * 0.2, H * 0.36, Math.PI / 8) }),
  // Tashkent facade: a band of precast panels
  facade: () => { const y0 = f1(H * 0.6), step = W / 10; return { fill: `M0 ${y0}H${W}V${H}H0Z`, cut: Array.from({ length: 9 }, (_, i) => `M${f1(step * (i + 1))} ${y0}V${H}`).join('') + `M0 ${f1(H * 0.8)}H${W}` }; },
  // Samarkand dome: ribbed, on its drum
  dome: () => {
    const cx = W * 0.8, w = H * 0.3, y1 = H * 0.7, y2 = H * 0.1;
    return {
      fill: `M${f1(cx - w)} ${H}V${f1(y1)}C${f1(cx - w)} ${f1(y1 - 0.28 * H)} ${f1(cx - 0.05 * H)} ${f1(y2 + 0.2 * H)} ${f1(cx)} ${f1(y2)}C${f1(cx + 0.05 * H)} ${f1(y2 + 0.2 * H)} ${f1(cx + w)} ${f1(y1 - 0.28 * H)} ${f1(cx + w)} ${f1(y1)}V${H}Z`,
      cut: [-2, -1, 0, 1, 2].map((j) => `M${f1(cx)} ${f1(y2 + 4)}Q${f1(cx + j * w * 0.5)} ${f1(y1 - 0.26 * H)} ${f1(cx + (j * w) / 2.4)} ${f1(y1)}`).join('') + `M${f1(cx - w)} ${f1(y1)}H${f1(cx + w)}`,
    };
  },
  // suzani: a medallion with eight round petals
  suzani: () => {
    const cx = W * 0.82, cy = H * 0.8, R = H * 0.34;
    return { fill: circle(cx, cy, R) + Array.from({ length: 8 }, (_, i) => circle(cx + R * Math.cos((i * Math.PI) / 4), cy + R * Math.sin((i * Math.PI) / 4), H * 0.12)).join(''), cut: circle(cx, cy, R * 0.6) + circle(cx, cy, R * 0.22) };
  },
  // mihrab: a pointed arch with its niche
  arch: () => ({ fill: pointed(W * 0.8, H * 0.3, H * 0.52, true), cut: pointed(W * 0.8, H * 0.18, H * 0.6, false) }),
};
const fl = F[field]();
const pat = `pl-${lat}${cell}`, box = `${W}x${H}`;
const c2 = cell / 2;
---
<div class:list={['plate', `plate--${t}`, idle && 'plate--idle', cls]} style={`aspect-ratio:${ratio}`} aria-hidden="true" data-art={`${motif}:${variant}:${t}`} data-seed={seed}>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <defs>
      {/* every colour in these defs is plain white, so plates can share them by id whatever their tone */}
      <pattern id={pat} width={cell} height={cell} patternUnits="userSpaceOnUse">
        {lat === 'dots' && <path fill="#fff" d={`M0 0h.01M${cell} 0h.01M0 ${cell}h.01M${cell} ${cell}h.01M${c2} ${c2}h.01`} stroke="#fff" stroke-width="2.6" stroke-linecap="round" />}
        {lat === 'grid' && <path fill="none" stroke="#fff" stroke-opacity=".6" stroke-width=".8" d={`M0 ${c2}H${cell}M${c2} 0V${cell}`} />}
        {lat === 'cross' && <path fill="none" stroke="#fff" stroke-width="1.2" d={`M${c2 - 3} ${c2}h6M${c2} ${c2 - 3}v6`} />}
      </pattern>
      <mask id={`${pat}-${box}`}><rect width={W} height={H} fill={`url(#${pat})`} /></mask>
      <radialGradient id="pl-rg" cx="50%" cy="48%" r="55%"><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
      <mask id={`pl-rm-${box}`}><rect width={W} height={H} fill="url(#pl-rg)" /></mask>
    </defs>
    <rect class="plate__bg" width={W} height={H} />
    <g transform={`matrix(${sx} 0 0 ${sy} ${sx < 0 ? W : 0} ${sy < 0 ? H : 0})`}>
      <path class="plate__field" d={fl.fill} />
      {fl.cut && <path class="plate__cut" d={fl.cut} />}
    </g>
    <rect class="plate__lattice" width={W} height={H} mask={`url(#${pat}-${box})`} />
    <g mask={`url(#pl-rm-${box})`}><rect class="plate__lattice plate__lattice--lit" width={W} height={H} mask={`url(#${pat}-${box})`} /></g>
    <g transform={`translate(${ex} ${ey}) scale(${flip ? -k : k} ${k})`}>
      {em.soft?.map((s) => <path class="plate__soft" d={s.d} />)}
      {em.lines.map((s) => <path class="plate__line" d={s.d} pathLength="1" style={s.delay ? `--i:${+s.delay.toFixed(2)}` : undefined} />)}
      {em.spin?.map((s) => <path class="plate__fill" d={s.d} />)}
      {em.fills?.map((s) => <path class="plate__fill" d={s.d} />)}
    </g>
  </svg>
</div>

<style>
  /* Tones mix the brand colours (and two from Uzbek tilework: terracotta brick and Samarkand turquoise) into the
     current theme's surfaces, so one plate sits right on every theme. --pl-field is the flat overprint behind the emblem. */
  .plate { position: relative; overflow: hidden; border-radius: var(--radius-media); isolation: isolate;
    --pl-bg: var(--wm-ink); --pl-field: color-mix(in oklab, var(--wm-ink), var(--wm-blue) 22%);
    --pl-dot: rgba(143, 180, 255, .2); --pl-dot-lit: rgba(143, 180, 255, .75); --pl-line: rgba(224, 232, 255, .9);
    --pl-fill: var(--wm-blue); --pl-soft: rgba(143, 180, 255, .26); }
  .plate--blue { --pl-bg: var(--wm-blue); --pl-field: color-mix(in oklab, var(--wm-blue), var(--wm-ink) 20%);
    --pl-dot: rgba(255, 255, 255, .2); --pl-dot-lit: rgba(255, 255, 255, .8); --pl-line: rgba(255, 255, 255, .94);
    --pl-fill: var(--wm-ink); --pl-soft: rgba(255, 255, 255, .24); }
  .plate--mist, .plate--sand, .plate--clay, .plate--teal {
    --pl-dot: color-mix(in oklab, var(--theme-foreground-primary) 17%, transparent); --pl-dot-lit: color-mix(in oklab, var(--wm-blue) 85%, transparent);
    --pl-line: var(--theme-foreground-primary); --pl-fill: var(--wm-blue); --pl-soft: color-mix(in oklab, var(--wm-blue) 24%, transparent); }
  .plate--mist { --pl-bg: color-mix(in oklab, var(--theme-background-primary), var(--wm-blue) 11%);
    --pl-field: color-mix(in oklab, var(--theme-background-primary), var(--wm-blue) 21%); }
  .plate--sand { --pl-bg: color-mix(in oklab, var(--theme-background-primary), #c9a45c 26%);
    --pl-field: color-mix(in oklab, var(--theme-background-primary), #c9a45c 44%);
    --pl-soft: color-mix(in oklab, var(--theme-foreground-primary) 13%, transparent); }
  .plate--clay { --pl-bg: color-mix(in oklab, var(--theme-background-primary), #c2603e 30%);
    --pl-field: color-mix(in oklab, var(--theme-background-primary), #c2603e 50%); }
  .plate--teal { --pl-bg: color-mix(in oklab, var(--theme-background-primary), #12968f 26%);
    --pl-field: color-mix(in oklab, var(--theme-background-primary), #12968f 46%); }
  .plate::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px var(--theme-border-tertiary); pointer-events: none; }
  .plate svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .plate__bg { fill: var(--pl-bg); }
  .plate__field { fill: var(--pl-field); }
  .plate__cut { fill: none; stroke: var(--pl-bg); stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .plate__lattice { fill: var(--pl-dot); }
  .plate__lattice--lit { fill: var(--pl-dot-lit); opacity: 0; }
  .plate__line { fill: none; stroke: var(--pl-line); stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round;
    vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .plate__fill { fill: var(--pl-fill); }
  .plate__soft { fill: var(--pl-soft); }
  @media (prefers-reduced-motion: no-preference) {
    /* plates that stand alone (section heads) breathe the lattice slowly */
    .plate--idle .plate__lattice--lit { animation: plate-breathe 7s ease-in-out infinite; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    /* the card that holds the plate redraws the emblem's lines and lights the lattice: under .9 s, nothing scales */
    .plate__lattice--lit { transition: opacity .7s var(--ease-out-quart); }
    :global(:is(a, li, article):is(:hover, :focus-visible)) .plate .plate__line { animation: plate-draw .7s var(--ease-out-quart) both; animation-delay: calc(min(var(--i, 0), 4) * 50ms); }
    :global(:is(a, li, article):is(:hover, :focus-visible)) .plate .plate__lattice--lit { opacity: .6; }
  }
  @keyframes plate-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes plate-breathe { 0%, 100% { opacity: .1; } 50% { opacity: .6; } }
  @media (forced-colors: active) { .plate__bg, .plate__field { fill: Canvas; } .plate__line { stroke: CanvasText; } .plate__fill { fill: Highlight; } }
</style>
