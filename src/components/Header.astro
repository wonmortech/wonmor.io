---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import NavDropdown from './NavDropdown.astro';
import { href, locales, localeNames, localeShort, stripLocale, type Locale } from '../i18n/config';
import { navStart, navEnd, pageByKey, type NavMenu } from '../i18n/pages';
import { ui } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const here = stripLocale(Astro.url.pathname);

const isActive = (m: NavMenu) => {
  if (m.href) return here.startsWith(m.href);
  return (m.items ?? []).some((it) => 'key' in it && here.startsWith(pageByKey[it.key].path + '/'));
};
/* Theme swatches: page colour, then accent. "auto" follows the system. */
const themeGroups = [
  { name: ui.themeGroupBasic, items: [
    { key: 'auto', name: ui.themeAuto, a: '#faf9f5', b: '#1a1918' },
    { key: 'light', name: ui.themeLight, a: '#faf9f5', b: '#141413' },
    { key: 'dark', name: ui.themeDark, a: '#1a1918', b: '#faf9f5' },
  ] },
  { name: ui.themeGroupBrand, items: [
    { key: 'ink', name: ui.themeInk, a: '#0b0d24', b: '#2969ff' },
    { key: 'blueprint', name: ui.themeBlueprint, a: '#f5f8ff', b: '#2969ff' },
    { key: 'cobalt', name: ui.themeCobalt, a: '#1a4fd6', b: '#ffffff' },
  ] },
  { name: ui.themeGroupRead, items: [
    { key: 'contrast', name: ui.themeContrast, a: '#ffffff', b: '#000000' },
    { key: 'paper', name: ui.themePaper, a: '#f4ecd8', b: '#2e2418' },
  ] },
  { name: ui.themeGroupFx, items: [
    { key: 'dots', name: ui.themeDots, a: '#f6f7fb', b: '#2969ff', fx: 'dots' },
    { key: 'glass', name: ui.themeGlass, a: '#070818', b: '#2969ff', fx: 'glass' },
  ] },
];
const langLinks = locales.map((l) => ({ l, href: href(l, here), name: localeNames[l], short: localeShort[l] }));
---
<header class="site-header" data-header>
  <div class="hdr">
    <nav class="hdr__start" aria-label={ui.primaryNav[locale]}>
      {navStart.map((m) => <NavDropdown m={m} locale={locale} active={isActive(m)} currentHref={Astro.url.pathname} />)}
    </nav>

    <div class="hdr__logo"><Logo locale={locale} collapsible id="site-logo" /></div>

    <div class="hdr__end">
      <div class="hdr__end-nav">
        {navEnd.map((m) => <NavDropdown m={m} locale={locale} active={isActive(m)} currentHref={Astro.url.pathname} align="end" />)}
        <div class="nav-dd hdr__lang" data-dd>
          <button class="btn btn--tertiary btn--small btn--pill btn--trailing nav-dd__trigger" type="button" aria-expanded="false" aria-controls="dd-lang" aria-label={`${localeShort[locale]}, ${ui.language[locale]}: ${localeNames[locale]}`}>
            <Icon name="globe" />{localeShort[locale]}<Icon name="chevron-down" class="nav-dd__chev" />
          </button>
          <div class="nav-dd__popup nav-dd__popup--end" id="dd-lang" hidden>
            <ul role="list">
              {langLinks.map((x) => (
                <li><a class="nav-item" href={x.href} hreflang={x.l} lang={x.l} aria-current={x.l === locale ? 'true' : undefined}>{x.name}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="hdr__icons">
        <div class="nav-dd hdr__theme" data-dd data-theme-dd hidden>
          <button class="btn btn--tertiary btn--small btn--rounded btn--icon nav-dd__trigger" type="button" aria-expanded="false" aria-controls="dd-theme" aria-label={ui.theme[locale]}><span class="hdr__swatch" aria-hidden="true"></span></button>
          <div class="nav-dd__popup nav-dd__popup--end" id="dd-theme" hidden>
            {themeGroups.map((g, gi) => (
              <div class="hdr__theme-group" role="group" aria-labelledby={`thg-${gi}`}>
                <p class="hdr__theme-label" id={`thg-${gi}`}>{g.name[locale]}</p>
                <ul role="list">
                  {g.items.map((t) => (
                    <li><button class="nav-item hdr__theme-opt" type="button" data-theme-set={t.key} aria-pressed="false">
                      <span class="hdr__theme-name"><span class:list={['hdr__dot', t.fx && `hdr__dot--${t.fx}`]} style={`--a:${t.a};--b:${t.b}`} aria-hidden="true"></span>{t.name[locale]}</span><Icon name="check" class="hdr__theme-check" />
                    </button></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
        <button class="btn btn--tertiary btn--small btn--rounded btn--icon" type="button" data-search-open aria-label={ui.search[locale]} aria-controls="hdr-search" aria-expanded="false"><Icon name="search" /></button>
        <button class="btn btn--tertiary btn--small btn--rounded btn--icon" type="button" data-menu-open aria-label={ui.openMenu[locale]} aria-controls="site-menu" aria-expanded="false"><Icon name="menu" /></button>
      </div>
      <form class="hdr__search" id="hdr-search" role="search" action={href(locale, '/search')} method="get" data-search>
        <Icon name="search" class="hdr__search-icon" />
        <label class="sr-only" for="hdr-q">{ui.search[locale]}</label>
        <input id="hdr-q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder={ui.searchPlaceholder[locale]} tabindex="-1" />
        <button class="btn btn--tertiary btn--small btn--rounded btn--icon" type="button" data-search-close aria-label={ui.closeSearch[locale]} tabindex="-1"><Icon name="close" /></button>
      </form>
    </div>
  </div>
</header>

<script>
  import '../scripts/header';
  import '../scripts/fx';
</script>

<style is:global>
  .site-header {
    position: sticky; top: 0; z-index: 100; height: var(--header-nav-height);
    background: var(--theme-background-primary); color: var(--theme-foreground-primary);
    transition: transform .3s var(--ease-out-quart), background-color .3s, color .3s;
  }
  .site-header[data-hidden] { transform: translateY(-100%); }
  .hdr {
    max-width: var(--grid-max-width); margin-inline: auto; padding-inline: var(--grid-margin); height: 100%;
    display: grid; align-items: center; column-gap: 16px;
    grid-template-columns: auto 1fr; grid-template-areas: 'logo end';
  }
  .hdr__start { grid-area: start; display: none; align-items: center; gap: 4px; }
  .hdr__logo { grid-area: logo; display: flex; justify-content: flex-start; }
  .hdr__end { grid-area: end; position: relative; display: flex; align-items: center; justify-content: flex-end; gap: 4px; min-width: 0; }
  .hdr__end-nav { display: flex; align-items: center; gap: 4px; transition: opacity .2s; }
  .hdr__end-nav > .nav-dd:not([data-menu='try']) { display: none; }
  .hdr__icons { display: flex; gap: 6px; margin-left: 4px; transition: opacity .2s; }
  .hdr__logo :global(.wm-logo) { min-height: 44px; display: inline-flex; align-items: center; }
  @media (pointer: coarse) { .hdr__icons :global(.btn--icon) { --btn-h: 40px; } }
  @media (max-width: 639px) {
    .hdr__end-nav { display: none; }
    .site-header .wm-logo__word { width: 0; }
  }
  @media (min-width: 1100px) {
    .hdr { grid-template-columns: auto 1fr auto; grid-template-areas: 'logo start end'; }
    .hdr__start { display: flex; justify-content: flex-end; padding-right: 8px; }
    .hdr__end-nav > .nav-dd { display: block !important; }
  }
  @media (min-width: 1400px) {
    .hdr { grid-template-columns: 1fr auto 1fr; grid-template-areas: 'start logo end'; }
    .hdr__start { justify-content: flex-start; padding-right: 0; }
    .hdr__logo { justify-content: center; }
  }

  /* dropdown (DESIGN.md §5.2) */
  .nav-dd { position: relative; }
  .nav-dd__chev { transition: transform .15s var(--ease-out-quart); }
  .nav-dd__trigger[aria-expanded='true'] {
    --btn-bg: var(--theme-button-primary-background); --btn-fg: var(--theme-button-primary-foreground); --btn-border: var(--theme-button-primary-border);
  }
  .nav-dd__trigger[aria-expanded='true']:hover { background: var(--btn-bg) !important; color: var(--btn-fg) !important; }
  .nav-dd__trigger[aria-expanded='true'] .nav-dd__chev { transform: rotate(180deg); }
  .nav-dd__popup {
    position: absolute; top: calc(100% + 8px); left: 0; z-index: 10;
    background: var(--theme-popup-background); border: 1px solid var(--theme-border-secondary); border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, .05); padding: 10px; min-width: 200px;
    transform-origin: top left; transition: opacity .15s ease, transform .15s ease;
  }
  .nav-dd__popup--end { left: auto; right: 0; transform-origin: top right; }
  .nav-dd__popup[hidden] { display: none; }
  .nav-dd__popup[data-starting] { opacity: 0; transform: scale(.9); }
  .nav-dd__popup ul { list-style: none; display: grid; grid-template-columns: repeat(var(--cols, 1), minmax(170px, 1fr)); column-gap: 8px; }
  .nav-item {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 28px; padding: 4px 16px; border-radius: 8px;
    font: 400 var(--fs-caption-1)/1.4 var(--sans); letter-spacing: .01em; color: var(--theme-button-tertiary-foreground); text-decoration: none; white-space: nowrap;
    transition: background-color .2s, color .2s;
  }
  .nav-item:hover, .nav-item:focus-visible { background: var(--theme-background-tertiary); color: var(--theme-foreground-primary); }
  .nav-item:focus-visible { outline: 2px solid var(--theme-focus-ring); outline-offset: -2px; }
  .nav-item[aria-current] { color: var(--theme-foreground-primary); font-weight: 700; }
  .nav-item .icon { flex: none; width: 12px; height: 12px; color: var(--theme-foreground-tertiary); }

  /* theme picker */
  .hdr__swatch { width: 16px; height: 16px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--theme-border-primary);
    background: linear-gradient(135deg, var(--theme-background-primary) 50%, var(--wm-mark) 50%); }
  .hdr__theme-opt { width: 100%; border: 0; background: transparent; cursor: pointer; text-align: left; }
  .hdr__theme-name { display: flex; align-items: center; gap: 10px; }
  .hdr__dot { flex: none; width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(128, 128, 128, .45);
    background: linear-gradient(135deg, var(--a) 50%, var(--b) 50%); }
  #dd-theme { max-height: calc(100svh - var(--header-nav-height) - 16px); overflow-y: auto; overscroll-behavior: contain; min-width: 228px; }
  .hdr__theme-group + .hdr__theme-group { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--theme-border-tertiary); }
  .hdr__theme-label { padding: 6px 12px 2px; font: 600 12px/1.4 var(--sans); letter-spacing: .03em; text-transform: uppercase; color: var(--theme-foreground-tertiary); }
  /* effect themes preview their texture in the swatch: a dot lattice, or frosted light */
  .hdr__dot--dots { background: radial-gradient(circle, var(--b) 1px, transparent 1.4px) 0 0 / 5px 5px, radial-gradient(circle, var(--b) 1px, transparent 1.4px) 2.5px 2.5px / 5px 5px, var(--a); }
  .hdr__dot--glass { background: radial-gradient(circle at 30% 30%, rgba(143, 180, 255, .95), transparent 55%), radial-gradient(circle at 75% 80%, rgba(41, 105, 255, .8), transparent 60%), var(--a); }
  .hdr__theme-opt .hdr__theme-check { visibility: hidden; }
  .hdr__theme-opt[aria-pressed='true'] { color: var(--theme-foreground-primary); font-weight: 700; }
  .hdr__theme-opt[aria-pressed='true'] .hdr__theme-check { visibility: visible; color: var(--theme-foreground-primary); }

  /* search (DESIGN.md §5.1) */
  .hdr__search {
    position: absolute; inset: 50% 0 auto auto; transform: translateY(-50%); width: min(520px, 100%); height: 36px;
    display: flex; align-items: center; gap: 8px; padding: 0 4px 0 12px;
    background: var(--theme-button-tertiary-background); border: 1px solid var(--theme-border-secondary); border-radius: 10px;
    clip-path: inset(0 0 0 100% round 10px); visibility: hidden;
    transition: clip-path .3s var(--ease-swap), visibility 0s .3s;
  }
  .hdr__search input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; font: 400 var(--fs-body-4)/1 var(--sans); }
  .hdr__search input::-webkit-search-cancel-button { display: none; }
  .hdr__search-icon { color: var(--theme-foreground-tertiary); flex: none; }
  .hdr__search:focus-within { border-color: var(--theme-border-primary); }
  .site-header[data-search-open] .hdr__search { clip-path: inset(0 0 0 0 round 10px); visibility: visible; transition: clip-path .3s var(--ease-swap); }
  .site-header[data-search-open] :is(.hdr__end-nav, .hdr__icons) { opacity: 0; pointer-events: none; }
  @media (max-width: 1099px) { .site-header[data-search-open] .hdr__start { display: none; } }
</style>
