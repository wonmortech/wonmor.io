---
/* /demo: every product running in the browser on sample data. Cards: cover, title, tagline, sign-in, actions. */
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { href, asset, type Locale } from '../../i18n/config';
import { pageByKey } from '../../i18n/pages';
import { ui } from '../../i18n/ui';
import { demos, demoGroups, demoPath, type DemoGroup } from '../../data/demos';
import { demoUi as U } from '../../i18n/demos';

interface Props { locale: Locale }
const { locale } = Astro.props;
const order: DemoGroup[] = ['dtwin', 'work', 'dev', 'trust', 'live'];
const count = demos.filter((d) => !d.liveOnly).length;
const productHref = (p?: string) => (p && pageByKey[`p-${p}`] ? href(locale, pageByKey[`p-${p}`].path) : undefined);
---
<Base locale={locale} title={`${U.title[locale]} · Wonmor`} description={U.description[locale]}>
  <article class="dg">
    <header class="container page-top dg__head">
      <p class="t-caption fg-3"><a class="link-quiet" href={href(locale, '/products')}>{pageByKey['products'].title[locale]}</a></p>
      <h1 class="t-headline-2 dg__title">{U.hero[locale]}</h1>
      <p class="t-sub-3 fg-2 dg__lede">{U.lede[locale].replace('{n}', String(count))}</p>
      <ul class="dg__facts t-caption" role="list">
        {U.facts.map((f) => <li><Icon name="check" size={16} />{f[locale]}</li>)}
      </ul>
    </header>

    {order.map((g) => {
      const list = demos.filter((d) => d.group === g);
      return (
        <section class="container dg__group" aria-labelledby={`dg-${g}`}>
          <div class="rule-row">
            <h2 class="t-caption-bold" id={`dg-${g}`}>{demoGroups[g][locale]}</h2>
            <span class="t-caption fg-3">{list.length}</span>
          </div>
          <ul class="dg__grid" role="list">
            {list.map((d) => {
              const open = d.liveOnly ? d.site! : demoPath(d.slug);
              const page = productHref(d.product);
              return (
                <li class="dcard" id={d.slug}>
                  <a class="dcard__media" href={open} target={d.liveOnly ? '_blank' : undefined} rel={d.liveOnly ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
                    <img src={asset(`/demo/_covers/${d.slug}.webp`)} alt="" width="960" height="600" loading="lazy" decoding="async" />
                  </a>
                  <div class="dcard__top">
                    <h3 class="t-headline-5">{d.title}</h3>
                    {d.liveOnly ? <span class="chip chip--dot">{U.liveSite[locale]}</span> : d.note && <span class="chip">{d.note[locale]}</span>}
                  </div>
                  <p class="t-body-4 dcard__desc">{d.tagline[locale]}</p>
                  {d.login && (
                    <p class="t-caption dcard__login">
                      {d.login.auto ? U.autoSignIn[locale] : U.signIn[locale]}{d.login.who && <> ({d.login.who[locale]})</>}{d.login.creds && <>: <code>{d.login.creds}</code></>}
                    </p>
                  )}
                  <div class="dcard__actions">
                    <a class="btn btn--primary btn--small btn--rounded btn--trailing" href={open} target={d.liveOnly ? '_blank' : undefined} rel={d.liveOnly ? 'noopener' : undefined}>
                      {d.liveOnly ? U.openSite[locale] : U.openDemo[locale]}<Icon name={d.liveOnly ? 'arrow-up-right' : 'arrow-right'} />
                      <span class="sr-only">: {d.title}{d.liveOnly && ` ${ui.external[locale]}`}</span>
                    </a>
                    {d.repo && (
                      <a class="btn btn--secondary btn--small btn--rounded" href={d.repo} target="_blank" rel="noopener">
                        <Icon name="github" />{U.source[locale]}<span class="sr-only">: {d.title} {ui.external[locale]}</span>
                      </a>
                    )}
                    {page ? (
                      <a class="btn btn--ghost btn--small btn--rounded" href={page}>{U.productPage[locale]}<span class="sr-only">: {d.title}</span></a>
                    ) : d.site && !d.liveOnly && (
                      <a class="btn btn--ghost btn--small btn--rounded btn--trailing" href={d.site} target="_blank" rel="noopener">
                        {d.site.replace(/^https?:\/\//, '')}<Icon name="arrow-up-right" /><span class="sr-only">{ui.external[locale]}</span>
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}

    <p class="container t-caption fg-3 dg__note">{U.thirdParty[locale]}</p>
  </article>
</Base>

<style>
  .dg__title { max-width: 18em; margin-top: 12px; }
  .dg__lede { max-width: 42em; margin-top: 24px; }
  .dg__facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 28px; color: var(--theme-foreground-secondary); }
  .dg__facts li { display: inline-flex; align-items: center; gap: 8px; }
  .dg__group { margin-top: var(--section-spacer-md, 96px); }
  .dg__grid { list-style: none; display: grid; gap: 48px var(--grid-gutter); margin-top: 28px; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .dg__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .dg__grid { grid-template-columns: repeat(3, 1fr); } }
  .dcard { display: flex; flex-direction: column; gap: 10px; min-width: 0; scroll-margin-top: 96px; }
  .dcard__media { display: block; aspect-ratio: 16 / 10; border-radius: var(--radius-media); overflow: hidden; margin-bottom: 8px;
    background: var(--gray-150); box-shadow: inset 0 0 0 1px rgba(20, 20, 19, .06); }
  .dcard__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .8s var(--ease-out-quart); }
  @media (hover: hover) { .dcard__media:hover img { transform: scale(1.03); } }
  .dcard__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .dcard__desc { color: var(--theme-foreground-secondary); }
  .dcard__login { color: var(--theme-foreground-tertiary); overflow-wrap: anywhere; }
  .dcard__login code { font: 500 .95em/1.4 var(--mono); color: var(--theme-foreground-secondary); }
  .dcard__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 6px; }
  .dcard__actions .btn { min-height: 44px; }
  .dg__note { max-width: 56em; margin-top: 72px; padding-bottom: var(--section-spacer-lg); }
</style>
